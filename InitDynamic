<script>
/* =======================================================================
 * Tempo Work Attribute helper — Banner Script  (V4.2)
 * - Uses ScriptRunner endpoint: /rest/scriptrunner/latest/custom/tempoWorkType?issueKey=${issue.key}
 * - Injects/controls Tempo Dynamic Dropdown work attribute (“Task”, key=_Picker_, id=14)
 * - KTAXA group bypass supported
 * - Activity Code check: customfield_17447 (DM-* only, with exemptions)
 * - Disables Log Time/Update when AC missing and no Task chosen
 * - Robust issue-key extraction for both Create and Edit dialogs
 * ======================================================================= */

(function () {
  const LOG_PREFIX = '[WorkAttr]';
  const ATTR_ID = 14;              // Tempo work attribute id
  const ATTR_KEY = '_Picker_';     // Tempo work attribute key (string key!)
  const ATTR_NAME = 'Task';        // Display name (you renamed it to "Task")
  const SR_ENDPOINT = '/rest/scriptrunner/latest/custom/tempoWorkType';
  const AC_FIELD = 'customfield_17447'; // "Activity Code"
  const EXEMPT_ISSUES = new Set([
    'DM-36231','DM-41282','DM-41281','DM-41280','DM-36382' // add/remove as needed
  ]);
  const K_TAXA_GROUP = 'DM-KTAXA'; // If user belongs here, bypass everything

  // Defensive single-boot
  if (window.__tempoWorkAttrBooted) return;
  window.__tempoWorkAttrBooted = true;

  // Small logger helpers
  const log  = (...a) => console.log(`${LOG_PREFIX}`, ...a);
  const warn = (...a) => console.warn(`${LOG_PREFIX}`, ...a);

  // Global-ish state
  const S = {
    bypass: false,             // true for KTAXA
    lastIssueKey: null,        // last resolved issue key for the current form
    lastOptions: [],           // last options fetched from SR
    selection: '',             // current chosen Task value (label)
    wiredForms: new WeakSet(), // to avoid double-wiring a single DOM node
    xhrPatched: false
  };

  // -------------------- KTAXA bypass (one-time) -------------------------
  (async function checkKTAXA() {
    try {
      const r = await fetch('/rest/api/2/myself?expand=groups');
      if (r.ok) {
        const j = await r.json();
        const groups = (j?.groups?.items || []).map(g => g.name || g?.displayName);
        if (groups.includes(K_TAXA_GROUP)) {
          S.bypass = true;
          log('Bypass enabled for KTAXA, group =', K_TAXA_GROUP);
        }
      }
    } catch (e) {
      // Non-fatal; proceed normally
    }
  })();

  // -------------------- Robust issue-key extraction ----------------------
  function extractIssueKey(form) {
    if (!form) return null;

    // 1) Most reliable: an anchor linking to /browse/KEY-123
    const anchor = form.querySelector('a[href*="/browse/"]');
    if (anchor) {
      const m = (anchor.getAttribute('href') || '').match(/[A-Z][A-Z0-9]+-\d+/i);
      if (m) return m[0].toUpperCase();
    }

    // 2) Elements that often carry issue key
    const dataEl = form.querySelector('[data-issue-key], [data-issueKey], [data-testid*="issue"]');
    if (dataEl) {
      const cand =
        dataEl.getAttribute('data-issue-key') ||
        dataEl.getAttribute('data-issueKey') ||
        dataEl.textContent || '';
      const m = cand.match(/[A-Z][A-Z0-9]+-\d+/i);
      if (m) return m[0].toUpperCase();
    }

    // 3) Issue picker chip / input
    const picker =
      form.querySelector('#issuePickerInput') ||
      form.querySelector('[id*="issuePicker"]') ||
      form.querySelector('[aria-controls*="issue-picker"], [role="combobox"][aria-haspopup="listbox"]');
    if (picker) {
      const cand = picker.value || picker.getAttribute('value') || picker.textContent || '';
      const m = cand.match(/[A-Z][A-Z0-9]+-\d+/i);
      if (m) return m[0].toUpperCase();
    }

    // 4) Fallback: default Tempo description "Working on issue KEY-123"
    const desc = form.querySelector('#comment, textarea[id*="comment"]');
    if (desc && typeof desc.value === 'string') {
      const m = desc.value.match(/[A-Z][A-Z0-9]+-\d+/i);
      if (m) return m[0].toUpperCase();
    }

    // 5) Light scan of visible text in header/body
    const scanNodes = Array.from(
      form.querySelectorAll(
        'header, h1, h2, h3, .sc-cUEIKg, .sc-jDDxOa, label, .sc-kItwNn, .sc-bKhNmF, .css-1hwfws3, .css-stm2gu-singleValue, span, div, a'
      )
    ).slice(0, 400);
    for (const n of scanNodes) {
      const t = (n.textContent || '').trim();
      if (!t) continue;
      const m = t.match(/[A-Z][A-Z0-9]+-\d+/i);
      if (m) return m[0].toUpperCase();
    }

    return null;
  }

  // --------------- Find native Task row + current value ------------------
  function findNativeTaskRow(form) {
    // look for the label that says "Task"
    const labels = Array.from(form.querySelectorAll('label'));
    const lab = labels.find(l => (l.textContent || '').trim().toLowerCase() === ATTR_NAME.toLowerCase());
    if (!lab) return null;
    // row container is usually two levels up
    return lab.closest('.sc-bKhNmF') || lab.parentElement?.parentElement || lab.parentElement;
  }

  function readNativeSelectedTask(form) {
    const row = findNativeTaskRow(form);
    if (!row) return '';
    const valEl =
      row.querySelector('.css-stm2gu-singleValue, .css-1uccc91-singleValue, .sc-bBrHrO, [data-testid*="singleValue"]');
    const txt = (valEl?.textContent || '').trim();
    return txt;
  }

  // ---------------------- Build custom UI once per form ------------------
  function ensureCustomField(form) {
    let host = form.querySelector('#custom-workattr-host');
    if (host) return host;

    host = document.createElement('div');
    host.id = 'custom-workattr-host';
    host.className = 'custom-workattr-host'; // for quick styling if needed
    host.style.marginTop = '6px';

    host.innerHTML = `
      <div class="sc-bKhNmF LBFFT" type="default">
        <div class="sc-cgFpzT eGniAY">
          <label class="sc-jvLaUc cSDnQh sc-jhfVAM lauuLP">${ATTR_NAME} (from API)</label>
        </div>
        <div class="sc-jDDxOa geIDWX">
          <select id="custom-workattr-select" class="sc-cTQhss gwKKdf" style="width:100%; height:40px;">
            <option value="">Select an option...</option>
          </select>
          <div id="custom-workattr-warning" style="color:#d12926; font-size:12px; margin-top:4px; display:none;">
            <!-- message goes here -->
          </div>
          <div id="custom-workattr-note" style="color:#6b778c; font-size:12px; margin-top:4px; display:none;">
            <!-- small note -->
          </div>
        </div>
      </div>
    `;

    // Insert right after the native row if present; else at end of form content
    const nativeRow = findNativeTaskRow(form);
    if (nativeRow && nativeRow.parentElement) {
      nativeRow.parentElement.insertBefore(host, nativeRow.nextSibling);
      // Hide native row so users always use the API-driven one
      nativeRow.style.display = 'none';
      nativeRow.classList.add('workattr-hide-native');
    } else {
      (form.querySelector('.sc-bKhNmF') || form).appendChild(host);
    }

    // Selection change => update S.selection + gate
    host.querySelector('#custom-workattr-select').addEventListener('change', () => {
      const sel = host.querySelector('#custom-workattr-select');
      S.selection = sel.value || '';
      applyGate(form); // re-evaluate blocking rule
    });

    return host;
  }

  function populateOptions(form, values, preselectLabel) {
    S.lastOptions = values || [];
    const host = ensureCustomField(form);
    const sel = host.querySelector('#custom-workattr-select');

    // rebuild
    const chosen = S.selection || preselectLabel || '';
    sel.innerHTML = `<option value="">Select an option...</option>`;
    S.lastOptions.forEach(o => {
      const opt = document.createElement('option');
      opt.value = o.value;
      opt.textContent = o.value;
      if (o.value === chosen) opt.selected = true;
      sel.appendChild(opt);
    });

    // if we preselected via edit mode
    if (chosen && !S.selection) S.selection = chosen;
  }

  // ---------------------- Fetch options via JSONP ------------------------
  function fetchOptionsJSONP(issueKey) {
    return new Promise((resolve) => {
      const cbName = `tempoWorkAttrCB_${Math.random().toString(36).slice(2)}`;
      const script = document.createElement('script');
      const url = `${SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}&callback=${cbName}`;
      let done = false;

      window[cbName] = (data) => {
        if (done) return;
        done = true;
        try { resolve(data?.values || []); }
        catch { resolve([]); }
        script.remove();
        delete window[cbName];
      };

      script.src = url;
      script.onerror = () => {
        if (!done) {
          done = true;
          resolve([]);
          try { delete window[cbName]; } catch {}
          script.remove();
        }
      };
      document.body.appendChild(script);
    });
  }

  // ---------------------- Activity Code check (Jira) ---------------------
  async function hasActivityCode(issueKey) {
    try {
      const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`);
      if (!r.ok) return false;
      const j = await r.json();
      const v = j?.fields?.[AC_FIELD];
      if (v == null) return false;
      if (typeof v === 'string') return v.trim().length > 0;
      // array/object fallback
      return Boolean(v);
    } catch {
      return false;
    }
  }

  // ---------------------- Button enable/disable --------------------------
  function getSubmitButton(form) {
    // Tempo uses named buttons; prefer name attr
    return form.querySelector('[name="submitWorklogButton"]')
        || Array.from(form.querySelectorAll('button'))
             .find(b => /^(log time|update)$/i.test((b.textContent || '').trim()));
  }

  function setButtonDisabled(form, disabled, reasonMsg) {
    const btn = getSubmitButton(form);
    if (!btn) return;

    if (disabled) {
      btn.setAttribute('disabled', '');
      btn.setAttribute('data-state', 'not-active');
      btn.style.opacity = '0.6';
    } else {
      btn.removeAttribute('disabled');
      btn.setAttribute('data-state', 'active');
      btn.style.opacity = '';
    }

    const host = ensureCustomField(form);
    const warnBox = host.querySelector('#custom-workattr-warning');
    if (disabled) {
      warnBox.textContent =
        'Log Time is disabled since Activity Code is not yet available. ' +
        'Please select your Domain BAU demand to log it temporarily to BAU.';
      warnBox.style.display = 'block';
    } else {
      warnBox.textContent = '';
      warnBox.style.display = 'none';
    }
  }

  // ---------------------- Gate evaluation & message ----------------------
  async function applyGate(form) {
    if (S.bypass) {
      setButtonDisabled(form, false);
      return;
    }
    const key = S.lastIssueKey;
    if (!key) {
      setButtonDisabled(form, false);
      return;
    }

    const isDM = /^DM-\d+$/i.test(key);
    const exempt = EXEMPT_ISSUES.has(key);

    // do we currently have a chosen Task?
    const hasTask = !!S.selection;

    let hasAC = true;
    if (isDM && !exempt) {
      // only then we check AC
      hasAC = await hasActivityCode(key);
    }

    const block = isDM && !exempt && !hasAC && !hasTask;
    log('gate', { key, hasAC, exempt, hasTask, block });

    setButtonDisabled(form, block);
  }

  // ---------------------- Wire a worklog form instance -------------------
  async function loadForCurrentForm(form) {
    if (!form || S.wiredForms.has(form)) return;
    S.wiredForms.add(form);

    // Prepare UI
    const host = ensureCustomField(form);

    // Resolve issue key & show options
    const key = extractIssueKey(form);
    S.lastIssueKey = key;
    if (!key) {
      warn('issueKey not found');
      populateOptions(form, [], '');
      setButtonDisabled(form, false);
      return;
    }

    log('Fetching options for', key);
    const values = await fetchOptionsJSONP(key);

    // Preselect from native (Edit dialog) if present
    const nativeSelected = readNativeSelectedTask(form);
    populateOptions(form, values, nativeSelected);

    // Apply block rule after initial paint
    applyGate(form).catch(()=>{});
  }

  // ---------------------- Observe dialog open/close ----------------------
  function findWorklogForm() {
    return document.querySelector('#worklogForm') ||
           document.querySelector('div[id^="worklogForm"]'); // safety
  }

  function wireFormIfPresent() {
    const form = findWorklogForm();
    if (!form) return;
    loadForCurrentForm(form);
  }

  const mo = new MutationObserver(() => wireFormIfPresent());
  mo.observe(document.body, { childList: true, subtree: true });

  // Also wire on initial load (if dialog already open)
  wireFormIfPresent();

  // ---------------------- Patch XHR to inject attribute ------------------
  function patchXHR() {
    if (S.xhrPatched) return;
    S.xhrPatched = true;

    const open = XMLHttpRequest.prototype.open;
    const send = XMLHttpRequest.prototype.send;

    XMLHttpRequest.prototype.open = function (method, url, async, user, pass) {
      this.__tempo = this.__tempo || {};
      this.__tempo.method = (method || '').toUpperCase();
      this.__tempo.url = url || '';
      return open.apply(this, arguments);
    };

    XMLHttpRequest.prototype.send = function (body) {
      try {
        const info = this.__tempo || {};
        const isWorklog =
          info.method === 'POST' || info.method === 'PUT' || info.method === 'PATCH';
        const url = info.url || '';

        // Tempo worklog endpoints (core/timesheets both seen)
        const target =
          /\/rest\/tempo-(?:core|timesheets)\/\d+\/worklogs(?:\/\d+)?\/?$/i.test(url);

        if (isWorklog && target && body && typeof body === 'string') {
          try {
            const obj = JSON.parse(body);
            obj.attributes = obj.attributes || {};

            // Only inject when we have a chosen value
            if (S.selection) {
              obj.attributes[ATTR_KEY] = S.selection;
              log('✅ Injected into XHR', { [ATTR_KEY]: S.selection });
            }
            body = JSON.stringify(obj);
          } catch { /* ignore parse errors */ }
        }
      } catch { /* no-op */ }

      return send.call(this, body);
    };
  }

  patchXHR();

  // ---------------------- Style tweak for hidden native row --------------
  const style = document.createElement('style');
  style.textContent = `
    .workattr-hide-native { display: none !important; }
  `;
  document.head.appendChild(style);

})();
</script>
