<script>
(() => {
  const LOG = (...a) => console.log("[WorkAttr]", ...a);

  /* ===== CONFIG ===== */
  const TEMPO_ATTR = { id: 14, key: "_Picker_", label: "Task" };
  const SR_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD = "customfield_17447";
  const EXEMPT_ISSUES = new Set(["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"]); // no AC warning

  /* ===== STATE ===== */
  const S = {
    formOpen:false,
    currentIssueKey:null,
    userPicking:false,
    savingUntil:0,
    cache:Object.create(null),     // issueKey -> [{key,value}]
    acCache:Object.create(null),   // issueKey -> boolean
    acPending:Object.create(null), // issueKey -> Promise<boolean>
    lastBlock:null,
    btnObserver:null,
  };

  /* ===== UTILS ===== */
  const now = () => Date.now();
  const debounce = (fn,ms=200)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms);}};

  const getForm = () => document.querySelector("#worklogForm");
  const getIssueKeyFromForm = () => {
    const f=getForm(); if(!f) return null;
    const m=(f.textContent||"").match(/[A-Z][A-Z0-9]+-\d+/);
    return m?m[0].toUpperCase():null;
  };
  const hasDMPrefix = k => !!(k && /^DM-\d+$/i.test(k));

  const getSubmitBtn = () => {
    const f=getForm(); if(!f) return null;
    return f.querySelector('button[name="submitWorklogButton"]')
        || [...f.querySelectorAll('button')].find(b => /^(Log Time|Update)$/i.test((b.textContent||"").trim()));
  };
  const setSubmitDisabled = (disabled) => {
    const btn = getSubmitBtn(); if(!btn) return;
    btn.disabled = !!disabled;
    btn.setAttribute("aria-disabled", disabled ? "true" : "false");
    btn.setAttribute("data-state", disabled ? "not-active" : "active");
    btn.classList.toggle("workattr--blocked", !!disabled);
  };

  function findNativeTaskRow(){
    const f = getForm(); if (!f) return null;
    const label = f.querySelector('label[for="_Picker_"]')
      || [...f.querySelectorAll('label')].find(l => /\bTask\b/i.test(l.textContent||""));
    if (!label) return null;
    return label.closest('div')?.parentElement || label.closest('div');
  }
  function hideNativeTask(){
    const row = findNativeTaskRow();
    if (row && !row.classList.contains("workattr-hide-native")) row.classList.add("workattr-hide-native");
  }

  function ensureCustomField(){
    const f=getForm(); if(!f) return null;
    let host=f.querySelector("#custom-workattr-host");
    if(!host){
      host=document.createElement("div");
      host.id="custom-workattr-host";
      const ref=findNativeTaskRow();
      if(ref&&ref.parentElement) ref.parentElement.insertBefore(host,ref);
      else f.appendChild(host);
      host.innerHTML=`
        <label style="display:block;margin-bottom:4px;">Task (from API)</label>
        <select id="custom-workattr-select" style="width:100%;height:32px;">
          <option value="">Select an option...</option>
        </select>
        <div id="custom-workattr-warning" style="display:none;color:#d92929;margin-top:6px;font-size:12px;"></div>
      `;
      const sel = host.querySelector("#custom-workattr-select");
      const arm = ()=>{ S.userPicking=true; setTimeout(()=>S.userPicking=false, 900); };
      ["mousedown","focus","click"].forEach(e=>sel.addEventListener(e,arm,true));
      sel.addEventListener("change", ()=>{
        window._tempoSelectedWorkAttr = sel.value ? { [TEMPO_ATTR.key]: sel.value } : null;
      });
    }
    return host;
  }
  const getCustomSelect = () => { const f=getForm(); return f && f.querySelector("#custom-workattr-select"); };
  const getWarningEl = () => { const f=getForm(); return f && f.querySelector("#custom-workattr-warning"); };

  function fillOptions(values){
    ensureCustomField();
    const sel=getCustomSelect(); if(!sel) return;
    const prev=sel.value;
    const sig=JSON.stringify(values?.map(v=>v.value)||[]);
    if (sel.dataset.sig!==sig){
      sel.dataset.sig=sig;
      sel.innerHTML=`<option value="">Select an option...</option>`;
      (values||[]).forEach(({value})=>{
        const o=document.createElement("option"); o.value=value; o.textContent=value; sel.appendChild(o);
      });
      if (prev && [...sel.options].some(o=>o.value===prev)) sel.value=prev; else sel.value="";
      window._tempoSelectedWorkAttr = sel.value ? { [TEMPO_ATTR.key]: sel.value } : null;
    }
  }

  function jsonpFetch(issueKey, timeoutMs=8000){
    return new Promise((resolve)=>{
      const cb=`tempoWorkAttrCB_${Math.random().toString(36).slice(2)}`;
      const sc=document.createElement("script"); let done=false;
      const cleanup=()=>{ if(done) return; done=true; delete window[cb]; sc.remove(); };
      const t=setTimeout(()=>{ cleanup(); resolve({values:[]}); }, timeoutMs);
      window[cb]=(data)=>{ clearTimeout(t); cleanup(); resolve(data||{values:[]}); };
      sc.onerror=()=>{ clearTimeout(t); cleanup(); resolve({values:[]}); };
      sc.src=`${SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}&callback=${cb}`;
      document.body.appendChild(sc);
    });
  }

  const loadForIssue = debounce(async (issueKey)=>{
    if (!issueKey || S.userPicking || now()<S.savingUntil) return;
    if (!S.cache[issueKey]){
      LOG("Fetching options for", issueKey);
      const data=await jsonpFetch(issueKey);
      S.cache[issueKey]=Array.isArray(data?.values)?data.values:[];
    }
    fillOptions(S.cache[issueKey]);
  }, 120);

  function getActivityStatus(issueKey){
    if (issueKey in S.acCache) return Promise.resolve(!!S.acCache[issueKey]);
    if (S.acPending[issueKey]) return S.acPending[issueKey];
    const url=`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`;
    const ctrl=new AbortController(); const timer=setTimeout(()=>ctrl.abort(),7000);
    const p=fetch(url,{signal:ctrl.signal})
      .then(r=>r.ok?r.json():null)
      .then(j=>{ clearTimeout(timer); const v=j?.fields?.[AC_FIELD]; const has=!!(v && String(v).trim()); S.acCache[issueKey]=has; return has; })
      .catch(()=>{ clearTimeout(timer); S.acCache[issueKey]=false; return false; })
      .finally(()=>{ delete S.acPending[issueKey]; });
    S.acPending[issueKey]=p; return p;
  }

  async function computeGate(){
    const key=S.currentIssueKey || getIssueKeyFromForm();
    const sel=getCustomSelect();
    const hasTask=!!(sel && sel.value);
    let warn=false, hasAC=true, exempt=false;

    if (hasDMPrefix(key)){
      exempt = EXEMPT_ISSUES.has(key);
      if (!exempt){
        hasAC = await getActivityStatus(key);
        warn = !hasAC;
      }
    }
    const block = warn || !hasTask;
    LOG(`gate key=${key||"-"} hasAC=${hasAC} exempt=${exempt} hasTask=${hasTask} => block=${block}`);
    return {block,warn,hasTask};
  }

  function startButtonObserver(){
    const btn=getSubmitBtn(); if (!btn) return;
    if (S.btnObserver){ try{S.btnObserver.disconnect();}catch{} S.btnObserver=null; }
    const obs=new MutationObserver(()=>{
      if (window._workattr_gate_block) setSubmitDisabled(true);
    });
    obs.observe(btn,{attributes:true,attributeFilter:["disabled","data-state","class"]});
    S.btnObserver=obs;
  }

  async function enforce(){
    const form=getForm(); if(!form) return;
    const {block,warn}=await computeGate();
    const w=getWarningEl();
    if (w) w.style.display = warn ? "block" : "none";
    window._workattr_gate_block = !!block;
    if (S.lastBlock !== block){
      S.lastBlock = block;
      setSubmitDisabled(block);
      startButtonObserver();
    } else {
      // nudge every pass
      setSubmitDisabled(block);
    }
  }

  // Click + Enter key guard
  document.addEventListener("click",(ev)=>{
    const btn=getSubmitBtn(); if(!btn) return;
    if (btn.contains(ev.target) && window._workattr_gate_block){ ev.preventDefault(); ev.stopPropagation(); btn.blur(); }
    else if (btn.contains(ev.target)){ S.savingUntil = now()+4000; }
  }, true);
  document.addEventListener("keydown",(ev)=>{
    if (ev.key==="Enter" && getForm() && window._workattr_gate_block){ ev.preventDefault(); ev.stopPropagation(); }
  }, true);

  function initForm(){
    hideNativeTask();
    ensureCustomField();
    S.lastBlock=null; window._workattr_gate_block=false;
    S.savingUntil=0; S.userPicking=false;
    const k=getIssueKeyFromForm();
    if (k && k!==S.currentIssueKey){ S.currentIssueKey=k; loadForIssue(k); }
    enforce();
    startButtonObserver();
  }

  // Dialog lifecycle poller (simple & robust)
  setInterval(()=>{
    const open=!!getForm();
    if (open!==S.formOpen){
      S.formOpen=open;
      if (open){ initForm(); } else { S.currentIssueKey=null; if (S.btnObserver){ try{S.btnObserver.disconnect();}catch{} S.btnObserver=null; } }
    } else if (open){
      const k=getIssueKeyFromForm();
      if (k && k!==S.currentIssueKey && now()>=S.savingUntil && !S.userPicking){ S.currentIssueKey=k; loadForIssue(k); }
      enforce();
    }
  }, 250);

  // Inject chosen Task into Tempo POST body
  const _fetch=window.fetch;
  window.fetch=function(url,opts,...rest){
    try{
      if (typeof url==="string" && url.includes("/rest/tempo-timesheets/4/worklogs/") && opts && typeof opts.body==="string"){
        const chosen = window._tempoSelectedWorkAttr && window._tempoSelectedWorkAttr[TEMPO_ATTR.key];
        if (chosen){
          const b=JSON.parse(opts.body||"{}");
          b.attributes = b.attributes || {};
          b.attributes[TEMPO_ATTR.id] = chosen;
          opts.body = JSON.stringify(b);
          LOG("✅ Injected into XHR POST", b.attributes);
        }
      }
    }catch(e){}
    return _fetch.apply(this,[url,opts,...rest]);
  };

  // Styles
  const css=document.createElement("style");
  css.textContent=`
    .workattr-hide-native{display:none!important}
    #custom-workattr-host{margin-top:8px}
    button.workattr--blocked{opacity:.6;pointer-events:auto}
  `;
  document.head.appendChild(css);

  LOG("Banner v3.5 – strong disable + observer + diagnostics loaded");
})();
</script>
