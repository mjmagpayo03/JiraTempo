<!-- ===== PROD legacy banner behaviors (safely wrapped) ===== -->
<script type="text/javascript">
(function(){
  // Prefer AJS.$, fallback to jQuery/$ if available
  const $ = (window.AJS && AJS.$) ? AJS.$ : (window.jQuery || window.$);
  if (!$) { return; } // quietly exit if no jQuery/AJS in this context

  function removeIssueType(){
    try{
      const HIDE = new Set(["Onboard Entity User","Onboard Platform User","Defect","Feedback","Epic","Story","Task","Bug"]);
      $(".aui-list-item-link").filter(function(){ return HIDE.has($(this).text().trim()); }).parent().hide();
    }catch(e){}
  }

  function removeUnwantedIssueTypes(){
    try{
      $("span.drop-menu").off("click.removeIssueType").on("click.removeIssueType", removeIssueType);
      $("#issuetype-field")
        .off(".removeIssueType")
        .on("keyup.removeIssueType", removeIssueType)
        .on("click.removeIssueType", () => setTimeout(removeIssueType,1));
      $("#project").off("change.removeIssueType").on("change.removeIssueType", () => {
        setTimeout(() => {
          if (typeof window.findIssueType === "function") { window.findIssueType(); }
          else { removeIssueType(); }
        }, 1000);
      });
    }catch(e){}
  }

  function overwriteNewDemandNames(){
    try{
      const url = String(window.location.href);
      if (url.includes("&demandnew=true")){ removeUnwantedIssueTypes(); }
      if (url.includes("&demandcustomized=true")){
        const hdr = $(".aui-page-header-inner").get(0);
        if (hdr && hdr.innerHTML) { hdr.innerHTML = hdr.innerHTML.replace("Create Issue","Create Demand"); }
        $('label[for="issuetype-field"]').text("Demand Type");
        $('label[for="issue-create-issue-type"]').text("Demand Type");
        $('label[for="project-field"]').parent().hide();
        $('label[for="issue-create-project-name"]').parent().hide();
      } else if (url.includes("CreateIssue.jspa")){
        const $projRow = $('label[for="issue-create-project-name"]').parent();
        const projectName = $projRow.children().eq(1).text();
        if (projectName === "Demand Management" || projectName === "Demand Management UAT"){
          const $typeRow = $('label[for="issue-create-issue-type"]').parent();
          const issueType = $typeRow.children().eq(2).text();
          if (issueType === "Service Delivery Demand" || issueType === "Solution Delivery Demand"){
            const hdr = $(".aui-page-header-inner").get(0);
            if (hdr && hdr.innerHTML) { hdr.innerHTML = hdr.innerHTML.replace("Create Issue","Create Demand"); }
            $projRow.hide();
            $('label[for="issue-create-issue-type"]').text("Demand Type");
          }
        }
      }
    }catch(e){}
  }

  function addCSSRule(sheet, selector, rules, index){
    try{
      if (!sheet) return;
      if ("insertRule" in sheet) { sheet.insertRule(`${selector}{${rules}}`, index); }
      else if ("addRule" in sheet) { sheet.addRule(selector, rules, index); }
    }catch(e){}
  }

  function hidePriority(){
    try{
      const p = window.location.pathname || "";
      const qs = window.location.search || "";
      const match = p.includes("RapidBoard.jspa") && (/projectKey=(DM|DMUAT|DMSTAGE|KDMSTAGE|KDM|KDMUAT)(&|$)/.test(qs));
      if (match){
        const sheet = (document.styleSheets && document.styleSheets[0]) || null;
        addCSSRule(sheet, ".ghx-priority", "display: none;", (sheet?.cssRules?.length || 0));
      }
    }catch(e){}
  }

  function replaceTAT(){
    try{
      if (window.JIRA && JIRA.ViewIssueTabs){
        JIRA.ViewIssueTabs.onTabReady(function(){
          const ttsSLA = $("#tts-sla-panel_heading");
          if (ttsSLA.length && !(ttsSLA.html() || "").includes("TAT Panel")){
            ttsSLA.find(".toggle-title").last().text("TAT Panel");
            ttsSLA.append("<style>.tts-sla-box__sla-prefix{visibility:hidden}.tts-sla-box__sla-prefix:before{content:'TAT';visibility:visible;position:absolute}</style>");
          }
        });
      }
    }catch(e){}
  }

  replaceTAT();
  $(window).on("load", function(){
    overwriteNewDemandNames();
    hidePriority();
  });
})();
</script>

<!-- ===== Tempo Work Attribute Helper — Core v6.1 (PROD) ===== -->
<script>
(() => {
  /* ============================================================
   * Tempo Work Attribute Helper — Core v6.1 (PROD)
   * - Uses native label "Task" (no "(from API)")
   * - Parent-only warning (no warning on Sub-task/Change Request)
   * - Disables dialog button when: no Task selected OR warning shown
   * - KTAXA group bypass (no custom field, no warning)
   * - JSONP Task list via ScriptRunner
   * - Observers re-init after Cancel/close
   * - Injects Task only on CREATE (POST) to avoid 500s on PUT edits
   * ============================================================ */

  /* ---------- Config (adjust if needed) ---------- */
  const ATTR_KEY        = "Task";                    // PROD label/key
  const NATIVE_LABEL    = "Task";                    // what the Tempo dialog shows
  const CUSTOM_LABEL    = "Task";                    // what we render
  const JSONP_ENDPOINT  = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD        = "customfield_17447";       // Activity Code field id (prod)
  const KTAXA_GROUP_NAME= "DM-KTAXA";

  // Show warning only for DM-* parent issues not in this exemption set:
  const EXEMPT_ISSUES   = new Set([
    // add PROD exemptions here, comma-separated (e.g. "DM-50267")
  ]);

  // treat these issue types as "not parent" (no warning)
  const SUBTASK_LIKE_TYPES = new Set(["Sub-task","Change Request"]);

  const OBSERVE_DEBOUNCE_MS = 120;

  /* ---------- State ---------- */
  const S = {
    ktaxa: null,
    lastIssueKey: null,
    lastSeenIssueKey: null,
    lastOptionsKey: null,
    selection: "",
    fetching: new Map(),
    acCache: new Map(),
    typeCache: new Map(),
    wiredXHR: false,
    wiredFetch: false,
    bodyMO: null,
    formMO: null,
    formMOStarted: false,
    debounceTimer: null
  };

  const log  = (...a) => console.log("%c[WorkAttr]", "color:#2aa", ...a);
  const warn = (...a) => console.warn("%c[WorkAttr]", "color:#d80", ...a);

  /* ---------- CSS ---------- */
  function onceStyle() {
    if (document.getElementById("workattr-style")) return;
    const css = `
      .workattr-hide-native{ display:none !important; }
      .custom-workattr-host{ margin:0 0 8px; }
      .custom-workattr-label{ font-weight:600; display:block; margin-bottom:6px; }
      .custom-workattr-select{ width:100%; height:40px; }
      .custom-workattr-warning{ color:#c00; font-size:.85rem; margin-top:6px; }
      .workattr-disabled-btn{ pointer-events:none !important; opacity:.6 !important; }
    `;
    const el = document.createElement("style");
    el.id = "workattr-style";
    el.textContent = css;
    document.head.appendChild(el);
  }

  /* ---------- Basics ---------- */
  const RX_KEY = /\b[A-Z][A-Z0-9]+-\d+\b/;
  const isDM   = k => /^DM-\d+$/i.test(k || "");

  function getForm() { return document.querySelector("#worklogForm"); }

  async function isKTAXA() {
    if (S.ktaxa !== null) return S.ktaxa;
    try {
      const r = await fetch("/rest/api/2/myself?expand=groups");
      if (!r.ok) throw 0;
      const me = await r.json();
      const names = (me?.groups?.items || []).map(g => (g?.name || "").toUpperCase());
      S.ktaxa = names.includes(KTAXA_GROUP_NAME.toUpperCase());
    } catch { S.ktaxa = false; }
    return S.ktaxa;
  }

  function extractIssueKeyFromDOM(form) {
    if (!form) return null;
    for (const a of form.querySelectorAll('a[href*="/browse/"]')) {
      const m = (a.getAttribute('href') || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    for (const el of form.querySelectorAll('[data-issue-key],[data-issueKey],[data-testid*="issue"],[data-test-id*="issue"]')) {
      const bag = [
        el.getAttribute('data-issue-key') || '',
        el.getAttribute('data-issueKey')  || '',
        el.getAttribute('data-testid')    || '',
        el.getAttribute('data-test-id')   || '',
        el.textContent || ''
      ].join(' ');
      const m = bag.match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const desc = form.querySelector('#comment, textarea[id*="comment"]');
    if (desc) {
      const m = (desc.value || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const m = (form.textContent || '').match(RX_KEY);
    return m ? m[0].toUpperCase() : null;
  }

  function sniffIssueKeyFromURL(url) {
    if (!url) return;
    let key = null;
    const mQ = url.match(/[?&]issueKey=([^&#]+)/i);
    if (mQ) key = decodeURIComponent(mQ[1]);
    else {
      const m1 = url.match(/\/issue\/([A-Z][A-Z0-9]+-\d+)/i);
      key = (m1 && m1[1]) || (url.match(RX_KEY) || [])[0] || null;
    }
    if (key) {
      key = key.toUpperCase();
      if (S.lastSeenIssueKey !== key) {
        S.lastSeenIssueKey = key;
        if (getForm()) setTimeout(loadForCurrentForm, 0);
      }
    }
  }

  /* ---------- DOM task row ---------- */
  function findNativeTaskRow(form) {
    if (!form) return null;
    // try 'for' first, then text
    let lab = form.querySelector(`label[for="${ATTR_KEY}"]`);
    if (!lab) lab = [...form.querySelectorAll("label")].find(l => (l.textContent || "").trim().toLowerCase() === NATIVE_LABEL.toLowerCase());
    if (!lab) return null;
    return lab.closest(".sc-bKhNmF") || lab.parentElement?.parentElement || lab.parentElement;
  }

  function ensureCustomHost(form) {
    if (!form) return null;
    let host = form.querySelector("#custom-workattr-host");
    if (host) return host;

    const row = findNativeTaskRow(form);
    if (!row) return null;

    row.classList.add("workattr-hide-native");

    host = document.createElement("div");
    host.id = "custom-workattr-host";
    host.className = "custom-workattr-host";
    host.innerHTML = `
      <label class="custom-workattr-label" for="custom-workattr-select">${CUSTOM_LABEL}</label>
      <select id="custom-workattr-select" class="custom-workattr-select">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" class="custom-workattr-warning" style="display:none;">
        Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.
      </div>
    `;
    row.parentElement?.insertBefore(host, row.nextSibling);
    return host;
  }

  function getCustomSelect(form){ return form?.querySelector("#custom-workattr-select") || null; }
  function getWarnBox(form){ return form?.querySelector("#custom-workattr-warning") || null; }
  function getSubmitBtn(form){
    return form?.querySelector('[name="submitWorklogButton"]')
        || [...(form?.querySelectorAll('button') || [])]
           .find(b => /^(log time|update)$/i.test((b.textContent || '').trim()));
  }

  function fillSelect(select, options, preselect) {
    const keep = new Set();
    select.innerHTML = `<option value="">Select an option...</option>`;
    for (const opt of options) {
      if (!opt || !opt.value) continue;
      if (keep.has(opt.value)) continue;
      keep.add(opt.value);
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.value;
      select.appendChild(o);
    }
    if (preselect && keep.has(preselect)) select.value = preselect;
  }

  /* ---------- Warning + Disable ---------- */
  function setSubmitBlocked(form, blocked) {
    const btn = getSubmitBtn(form);
    if (!btn) return;
    btn.disabled = !!blocked;
    btn.setAttribute("data-state", blocked ? "not-active" : "active");
    btn.setAttribute("aria-disabled", String(!!blocked));
    btn.classList.toggle("workattr-disabled-btn", !!blocked);
  }

  /* ---------- Data ---------- */
  function jsonp(url) {
    return new Promise((resolve, reject) => {
      const cb = "tempoWorkAttrCB_" + Math.random().toString(36).slice(2);
      const sep = url.includes("?") ? "&" : "?";
      const src = `${url}${sep}callback=${cb}`;
      const s = document.createElement("script");
      let done = false;

      window[cb] = (data) => { if (done) return; done = true; cleanup(); resolve(data); };
      function cleanup(){ try{delete window[cb]}catch{} s.remove(); }
      s.onerror = () => { if (done) return; done = true; cleanup(); reject(new Error("JSONP failed")); };
      s.src = src;
      document.body.appendChild(s);
    });
  }

  async function fetchOptionsFor(issueKey) {
    if (!issueKey) return [];
    if (S.fetching.has(issueKey)) return S.fetching.get(issueKey);
    const p = (async () => {
      const url = `${JSONP_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`;
      const data = await jsonp(url).catch(() => ({}));
      const list = Array.isArray(data?.values) ? data.values : [];
      return list.map(v => ({ key: v.key, value: v.value }));
    })();
    S.fetching.set(issueKey, p);
    return p;
  }

  async function hasActivityCode(issueKey) {
    if (!issueKey) return false;
    if (S.acCache.has(issueKey)) return S.acCache.get(issueKey);
    const ok = await (async () => {
      try {
        const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`);
        if (!r.ok) throw 0;
        const j = await r.json();
        const v = j?.fields?.[AC_FIELD];
        return !!(v && String(v).trim().length > 0);
      } catch {
        // fail-open to avoid blocking on transient errors
        return true;
      }
    })();
    S.acCache.set(issueKey, ok);
    return ok;
  }

  async function isParentIssue(issueKey){
    if (!issueKey) return false;
    if (S.typeCache.has(issueKey)) return S.typeCache.get(issueKey);
    const val = await (async () => {
      try{
        const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=issuetype`);
        if (!r.ok) throw 0;
        const j = await r.json();
        const it = j?.fields?.issuetype || {};
        const name = String(it?.name || "");
        const isSubtask = !!it?.subtask || SUBTASK_LIKE_TYPES.has(name);
        return !isSubtask;
      }catch{ return true; }
    })();
    S.typeCache.set(issueKey, val);
    return val;
  }

  /* ---------- Gate (warning + disable) ---------- */
  async function applyGate(form) {
    if (!form) return;

    // KTAXA: show native Task, no warning, no disable
    if (await isKTAXA()) {
      const row = findNativeTaskRow(form);
      if (row) row.classList.remove("workattr-hide-native");
      form.querySelector("#custom-workattr-host")?.remove();
      return;
    }

    const key      = S.lastIssueKey;
    const select   = getCustomSelect(form);
    const warnBox  = getWarnBox(form);
    const hasTask  = !!(select && select.value);

    let showWarn = false;
    if (key && isDM(key) && !EXEMPT_ISSUES.has(key)) {
      const [parent, ac] = await Promise.all([isParentIssue(key), hasActivityCode(key)]);
      showWarn = parent && !ac;
    }

    if (warnBox) warnBox.style.display = showWarn ? "block" : "none";

    // disable only inside the dialog form
    setSubmitBlocked(form, showWarn || !hasTask);
  }

  /* ---------- Main loader ---------- */
  async function loadForCurrentForm() {
    const form = getForm();
    if (!form) return;
    if (S.debounceTimer) clearTimeout(S.debounceTimer);

    S.debounceTimer = setTimeout(async () => {
      const issueKey = extractIssueKeyFromDOM(form) || S.lastSeenIssueKey;
      if (!issueKey) { warn("issueKey not found"); return; }

      if (S.lastIssueKey !== issueKey) {
        S.lastIssueKey = issueKey;
        // keep previous selection only within the same issue
        S.selection = "";
      }

      if (await isKTAXA()) {
        const row = findNativeTaskRow(form);
        if (row) row.classList.remove("workattr-hide-native");
        form.querySelector("#custom-workattr-host")?.remove();
        return;
      }

      onceStyle();
      const host = ensureCustomHost(form);
      if (!host) return;

      const select = getCustomSelect(form);
      if (S.lastOptionsKey !== issueKey) {
        const options = await fetchOptionsFor(issueKey).catch(() => []);
        S.lastOptionsKey = issueKey;
        fillSelect(select, options, S.selection);
      }

      if (!select.__workattrBound) {
        select.__workattrBound = true;
        select.addEventListener("change", () => {
          S.selection = select.value || "";
          applyGate(form);
        });
      }

      // re-evaluate on Cancel (dialog remounts)
      const cancelBtn = [...(form.querySelectorAll('button')||[])]
        .find(b => /cancel/i.test((b.textContent||"").trim()));
      if (cancelBtn && !cancelBtn.__workattrBound){
        cancelBtn.__workattrBound = true;
        cancelBtn.addEventListener("click", () => {
          // next open will rebuild cleanly
          setTimeout(loadForCurrentForm, 200);
        });
      }

      await applyGate(form);
    }, OBSERVE_DEBOUNCE_MS);
  }

  /* ---------- Observers ---------- */
  function wireObservers() {
    if (!S.bodyMO) {
      S.bodyMO = new MutationObserver(() => {
        const form = getForm();
        if (form && !S.formMOStarted) {
          if (!S.formMO) S.formMO = new MutationObserver(() => loadForCurrentForm());
          S.formMO.observe(form, { childList: true, subtree: true, characterData: true });
          S.formMOStarted = true;
          loadForCurrentForm();
        } else if (!form && S.formMOStarted) {
          S.formMO.disconnect();
          S.formMOStarted = false;
        }
      });
      S.bodyMO.observe(document.body, { childList: true, subtree: true });
    }
    loadForCurrentForm();
  }

  /* ---------- Injection guards ---------- */
  function looksLikeCreate(bodyObj) {
    if (!bodyObj || typeof bodyObj !== "object") return false;
    // create payload usually contains 'started' + 'timeSpentSeconds' and NOT originId
    if ("started" in bodyObj && "timeSpentSeconds" in bodyObj && !("originId" in bodyObj)) return true;
    return false;
  }

  /* ---------- Network wiring ---------- */
  function wireNetwork() {
    // XHR
    if (!S.wiredXHR) {
      S.wiredXHR = true;
      const _open = XMLHttpRequest.prototype.open;
      const _send = XMLHttpRequest.prototype.send;

      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        try { sniffIssueKeyFromURL(url); } catch {}
        this.__url = url || "";
        this.__method = (method || "").toUpperCase();
        return _open.call(this, method, url, ...rest);
      };

      XMLHttpRequest.prototype.send = function(body) {
        try {
          if (S.ktaxa === true) return _send.call(this, body);
          const isPOST = (this.__method || "") === "POST";
          // Only inject on CREATE (POST) to avoid 500s on PUT edits
          if (!isPOST || !body || typeof body !== "string") {
            return _send.call(this, body);
          }
          let obj; try { obj = JSON.parse(body); } catch { obj = null; }
          if (looksLikeCreate(obj)) {
            const form = getForm();
            const sel = form && getCustomSelect(form);
            const chosen = (sel && sel.value) || S.selection || "";
            if (chosen) {
              obj.attributes = obj.attributes || {};
              obj.attributes[ATTR_KEY] = chosen;
              body = JSON.stringify(obj);
              log("✅ Injected into XHR (create)", { [ATTR_KEY]: chosen });
            }
          }
        } catch (e) {
          warn("XHR inject skipped due to error:", e);
        }
        return _send.call(this, body);
      };
    }

    // fetch
    if (!S.wiredFetch && window.fetch) {
      S.wiredFetch = true;
      const _fetch = window.fetch;
      window.fetch = async (input, init = {}) => {
        try {
          const url  = typeof input === "string" ? input : (input?.url || "");
          const meth = (init?.method || "GET").toUpperCase();
          sniffIssueKeyFromURL(url);

          if (S.ktaxa === true) return _fetch(input, init);

          // Only inject on CREATE (POST)
          if (meth === "POST" && init?.body && typeof init.body === "string") {
            let obj; try { obj = JSON.parse(init.body); } catch { obj = null; }
            if (looksLikeCreate(obj)) {
              const form = getForm();
              const sel = form && getCustomSelect(form);
              const chosen = (sel && sel.value) || S.selection || "";
              if (chosen) {
                obj.attributes = obj.attributes || {};
                obj.attributes[ATTR_KEY] = chosen;
                init = { ...init, body: JSON.stringify(obj) };
                log("✅ Injected into fetch (create)", { [ATTR_KEY]: chosen });
              }
            }
          }
        } catch (e) {
          warn("fetch inject skipped due to error:", e);
        }
        return _fetch(input, init);
      };
    }
  }

  /* ---------- Boot ---------- */
  function boot() {
    onceStyle();
    wireNetwork();
    wireObservers();
    log("Ready (v6.1)");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
