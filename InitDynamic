<script>
(() => {
  /* ==============================
   * Tempo "Task (from API)" helper
   * Core v4 – stable build
   * ============================== */

  /* --------- Config --------- */
  const ATTR = { id: 14, key: "_Picker_", label: "Task" };            // Tempo work attribute
  const SR_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD = "customfield_17447";                                // Activity Code field
  const EXEMPT_KEYS = new Set(["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"]); // no warning/blocks
  const KTAXA_GROUP = "DM-KTAXA";                                      // bypass group
  const WARNING_TEXT = 'Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.';

  /* --------- State --------- */
  let BYPASS_FOR_KTAXA = false;                                        // skip all custom logic if true
  const optionsCache = new Map();                                      // issueKey -> [{key,value}]
  const acCache = new Map();                                           // issueKey -> boolean
  let lastSelectedValue = "";                                          // current select value we will inject
  let wiredFormId = null;                                              // to prevent double-wiring

  const log = (...a) => console.log("[WorkAttr]", ...a);
  const warn = (...a) => console.warn("[WorkAttr]", ...a);

  /* --------- Utilities --------- */

  // Robustly locate the current worklog form (create or edit)
  function getForm() {
    return document.querySelector("#worklogForm") || null;
  }

  // Prefer the issue picker input as anchor
  function findIssuePickerRoot(form) {
    return form.querySelector("#issuePickerInput")
        || form.querySelector('[aria-haspopup][aria-expanded]')
        || form;
  }

  // Find the native Task row and container
  function findNativeTaskRow(form) {
    const label = form.querySelector('label[for="_Picker_"]')
              || [...form.querySelectorAll("#worklogForm label")]
                   .find(l => /^\s*Task\s*$/i.test(l.textContent || ""));
    if (!label) return null;
    return label.closest(".sc-bKhNmF") || label.closest("div");
  }

  // Create/ensure our custom field right under the native row
  function ensureCustomField(form) {
    let host = form.querySelector("#custom-workattr-host");
    if (host) return host;

    host = document.createElement("div");
    host.id = "custom-workattr-host";
    host.className = "sc-bKhNmF LBFFT";
    host.setAttribute("type","default");
    host.innerHTML = `
      <div class="sc-cgFpzT eGniAY">
        <label class="sc-jvLaUc lauuLP" id="custom-workattr-label">${ATTR.label} (from API)</label>
      </div>
      <div class="sc-jDDxOa geIDWX">
        <select id="custom-workattr-select" class="sc-cTQhss gwKKdf" style="width:100%">
          <option value="">Select an option...</option>
        </select>
        <div id="custom-workattr-help" style="display:none; color:#c0392b; margin-top:6px;"></div>
      </div>`;

    const nativeRow = findNativeTaskRow(form);
    if (nativeRow && nativeRow.parentElement) {
      nativeRow.parentElement.insertBefore(host, nativeRow.nextSibling);
    } else {
      form.appendChild(host);
    }
    return host;
  }

  function showNativeTask(form, show) {
    const row = findNativeTaskRow(form);
    if (row) row.style.display = show ? "" : "none";
  }

  function removeCustomField(form) {
    const host = form.querySelector("#custom-workattr-host");
    if (host && host.parentElement) host.parentElement.removeChild(host);
  }

  // Read selected work issue key from the dialog, robust to both open/closed pickers
  function getIssueKeyFromForm() {
    const f = getForm(); if (!f) return null;
    const RE = /[A-Z][A-Z0-9]+-\d+/;

    // If the list is open and an active option exists
    const inp = f.querySelector("#issuePickerInput");
    if (inp) {
      const activeId = inp.getAttribute("aria-activedescendant");
      if (activeId) {
        const opt = document.getElementById(activeId);
        if (opt) {
          const m = (opt.textContent || "").match(RE);
          if (m) return m[0].toUpperCase();
        }
      }
      // Closed/summary trigger text
      const trigger =
        inp.closest("#worklogForm")?.querySelector('[aria-haspopup="listbox"], [aria-haspopup="dialog"]')
        || inp.closest("#worklogForm")?.querySelector('[data-testid*="issue"], [data-test*="issue"]');
      if (trigger) {
        const m = (trigger.textContent || "").match(RE);
        if (m) return m[0].toUpperCase();
      }
    }

    // Current selected row if listbox is open
    const selected = f.querySelector('[aria-selected="true"]');
    if (selected) {
      const m = (selected.textContent || "").match(RE);
      if (m) return m[0].toUpperCase();
    }

    // Fallback: scan once
    const m = (f.textContent || "").match(RE);
    return m ? m[0].toUpperCase() : null;
  }

  // JSONP utility (SR endpoint returns JSONP)
  function jsonp(url, params={}) {
    return new Promise((resolve, reject) => {
      const cb = "tempoWorkAttrCB_" + Math.random().toString(36).slice(2);
      params.callback = cb;
      const q = new URLSearchParams(params).toString();
      const src = url + (url.includes("?") ? "&" : "?") + q;

      const script = document.createElement("script");
      script.src = src;
      let done = false;
      window[cb] = (data) => {
        if (done) return;
        done = true;
        cleanup();
        resolve(data);
      };
      script.onerror = (e) => {
        if (done) return;
        done = true;
        cleanup();
        reject(e);
      };
      function cleanup() {
        try { delete window[cb]; } catch(_){}
        script.remove();
      }
      document.body.appendChild(script);
    });
  }

  // Fetch Task options for an issue
  async function fetchOptions(issueKey) {
    if (optionsCache.has(issueKey)) return optionsCache.get(issueKey);
    const data = await jsonp(SR_ENDPOINT, { issueKey });
    const values = Array.isArray(data?.values) ? data.values : [];
    optionsCache.set(issueKey, values);
    return values;
  }

  // Lookup Activity Code presence
  async function fetchHasAC(issueKey) {
    if (acCache.has(issueKey)) return acCache.get(issueKey);
    try {
      const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`, { credentials: "same-origin" });
      if (!r.ok) throw new Error(r.status);
      const j = await r.json();
      const v = j?.fields?.[AC_FIELD];
      const has = !!(Array.isArray(v) ? v.length : v);
      acCache.set(issueKey, has);
      return has;
    } catch (e) {
      warn("AC lookup failed for", issueKey, e);
      // Fail open to avoid blocking valid logs
      acCache.set(issueKey, true);
      return true;
    }
  }

  // Decide whether to block logging (disable button) and/or show warning
  async function computeGate(issueKey, hasTask) {
    const isDM = /^DM-\d+$/i.test(issueKey || "");
    const exempt = EXEMPT_KEYS.has((issueKey || "").toUpperCase());
    let hasAC = true;
    if (isDM && !exempt) {
      hasAC = await fetchHasAC(issueKey);
    }
    const block = isDM && !exempt && !hasAC;
    log("gate", { key: issueKey || null, hasAC, exempt, hasTask: !!hasTask, block });
    return { block, hasAC, exempt };
  }

  function setSubmitDisabled(disabled) {
    const f = getForm(); if (!f) return;
    const btn = f.querySelector('[name="submitWorklogButton"]')
             || f.querySelector('button[type="button"][name="submitWorklogButton"]');
    if (!btn) return;
    btn.disabled = !!disabled;
    btn.setAttribute("aria-disabled", disabled ? "true" : "false");
  }

  function showWarning(show, text = WARNING_TEXT) {
    const f = getForm(); if (!f) return;
    const help = f.querySelector("#custom-workattr-help");
    if (!help) return;
    help.textContent = show ? text : "";
    help.style.display = show ? "" : "none";
  }

  function clearSelect(select) {
    select.innerHTML = '<option value="">Select an option...</option>';
  }

  function populateSelect(select, values) {
    clearSelect(select);
    if (!values || !values.length) return;
    for (const v of values) {
      const opt = document.createElement("option");
      opt.value = v.value;
      opt.textContent = v.value;
      select.appendChild(opt);
    }
  }

  /* --------- Intercept XHR to inject our attribute --------- */
  (function patchXHR(){
    const _open = XMLHttpRequest.prototype.open;
    const _send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function(method, url){
      this.__tempo_url = url || "";
      this.__tempo_method = method || "";
      return _open.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function(body){
      try {
        if (this.__tempo_method === "POST" && /\/rest\/tempo-timesheets\/\d+\/worklogs\/?$/i.test(this.__tempo_url || "")) {
          if (typeof body === "string" && body.trim().startsWith("{")) {
            const payload = JSON.parse(body);
            if (!payload.attributes) payload.attributes = {};
            if (lastSelectedValue) {
              payload.attributes[ATTR.key] = lastSelectedValue;
              log("✅ Injected into XHR POST", { [ATTR.key]: lastSelectedValue });
            }
            body = JSON.stringify(payload);
          }
        }
      } catch (e) {
        warn("inject error", e);
      }
      return _send.call(this, body);
    };
  })();

  /* --------- Group bypass (KTAXA) --------- */
  (async function detectKTAXA(){
    try {
      const r = await fetch("/rest/api/2/myself?expand=groups", { credentials: "same-origin" });
      if (r.ok) {
        const j = await r.json();
        const items = j?.groups?.items || [];
        BYPASS_FOR_KTAXA = items.some(g => (g.name || "") === KTAXA_GROUP);
        if (BYPASS_FOR_KTAXA) log("bypass enabled for group", KTAXA_GROUP);
      }
    } catch (e) {
      // ignore
    }
  })();

  /* --------- Main form wiring --------- */
  async function loadForCurrentForm() {
    const form = getForm();
    if (!form) return;

    const formId = form.getAttribute("data-worklog-id") || "create";
    if (wiredFormId === formId && form.__workattrWired) return; // already wired
    form.__workattrWired = true;
    wiredFormId = formId;

    // If user is in KTAXA, keep native behavior and bail
    if (BYPASS_FOR_KTAXA) {
      showNativeTask(form, true);
      removeCustomField(form);
      return;
    }

    // Prepare UI
    showNativeTask(form, false);
    const host = ensureCustomField(form);
    const select = host.querySelector("#custom-workattr-select");

    // Reset state
    lastSelectedValue = "";
    clearSelect(select);
    showWarning(false);
    setSubmitDisabled(false);

    // When the issue changes, re-fetch options and recompute gate
    const onIssueChanged = debounce(async () => {
      const key = getIssueKeyFromForm();
      if (!key) { clearSelect(select); showWarning(false); setSubmitDisabled(false); return; }

      log("▶ Fetching options for", key);
      const values = await fetchOptions(key);
      log("JSONP callback", values);
      populateSelect(select, values);

      // Recompute gate (Activity Code + exemptions)
      const gate = await computeGate(key, !!select.value);
      showWarning(gate.block);
      setSubmitDisabled(gate.block);
    }, 120);

    // Change handlers
    select.addEventListener("change", async () => {
      lastSelectedValue = select.value || "";
      const key = getIssueKeyFromForm();
      const gate = await computeGate(key, !!lastSelectedValue);
      showWarning(gate.block);
      setSubmitDisabled(gate.block);
    });

    // Observe/attach to issue picker changes
    const root = findIssuePickerRoot(form);
    if (root) {
      ["input","change","keydown","keyup","click"].forEach(ev =>
        root.addEventListener(ev, onIssueChanged, { passive: true }));
    }

    // Also watch the form for structural changes (Log another, reopen, etc.)
    const mo = new MutationObserver(onIssueChanged);
    mo.observe(form, { subtree: true, childList: true, attributes: true, characterData: false });

    // First paint
    onIssueChanged();
  }

  // Simple debounce
  function debounce(fn, wait) {
    let t; return function(...a){ clearTimeout(t); t = setTimeout(() => fn.apply(this, a), wait); };
  }

  /* --------- Global observer: (re)wire when the dialog appears --------- */
  const rootMO = new MutationObserver(() => {
    const form = getForm();
    if (form) loadForCurrentForm();
  });
  rootMO.observe(document.body, { childList: true, subtree: true });

  // If the dialog is already open on load
  if (getForm()) loadForCurrentForm();

})();
</script>
