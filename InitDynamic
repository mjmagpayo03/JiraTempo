<!-- ===================== Tempo Work Attribute Helper — v6.6 ===================== -->
<script>
(() => {
  /* ============================================================
   * Tempo Work Attribute Helper — v6.6
   * - Works on Create + Edit (Grid & List)
   * - Resolves issueKey even when Edit modal doesn't show it
   * - Task dropdown (custom, JSONP)
   * - Hide native Task row (Grid + List)
   * - Warn for missing Activity Code (parent issues only)
   * - Disable submit when warning is visible OR no Task selected
   * - Inject {_Task_: "<choice>"} only for create/update payloads
   * ============================================================ */

  /* ---------- Config ---------- */
  const ATTR_KEY         = "_Task_";             // PROD attribute key
  const NATIVE_LABEL     = "Task";               // native field label
  const CUSTOM_LABEL     = "Task";               // shown label (no “from API”)
  const JSONP_ENDPOINT   = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD         = "customfield_17447";  // Activity Code field
  const EXEMPT_ISSUES    = new Set([
    // Add demand keys here to suppress the AC warning entirely
    "DM-50267","DM-50238"
  ]);
  const EXEMPT_TYPES     = new Set(["Sub-task","Sub-task (technical)","Change Request"]);
  const KTAXA_GROUP_NAME = "DM-KTAXA";

  const OBSERVE_DEBOUNCE_MS = 120;

  /* ---------- State ---------- */
  const S = {
    ktaxa: null,
    lastIssueKey: null,
    lastSeenIssueKey: null,
    lastOptionsKey: null,
    selection: "",
    fetching: new Map(),
    acCache: new Map(),
    typeCache: new Map(),
    wiredXHR: false,
    wiredFetch: false,
    bodyMO: null,
    formMO: null,
    formMOStarted: false,
    debounceTimer: null,
    // v6.6 additions:
    worklogKeyCache: new Map(),  // worklogId -> issueKey
    lastWorklogId: null,
  };

  const log  = (...a) => console.log("%c[WorkAttr]", "color:#2aa", ...a);
  const warn = (...a) => console.warn("%c[WorkAttr]", "color:#d80", ...a);

  /* ---------- CSS ---------- */
  function onceStyle() {
    if (document.getElementById("workattr-style")) return;
    const css = `
      .workattr-hide-native{ display:none !important; }
      .custom-workattr-host{ margin:8px 0 8px; }
      .custom-workattr-label{ font-weight:600; display:block; margin-bottom:6px; }
      .custom-workattr-select{ width:100%; height:40px; }
      .custom-workattr-warning{ color:#c00; font-size:.85rem; margin-top:6px; }
      .workattr-disabled-btn{ pointer-events:none !important; opacity:.6 !important; }
    `;
    const el = document.createElement("style");
    el.id = "workattr-style";
    el.textContent = css;
    document.head.appendChild(el);
  }

  /* ---------- Basics ---------- */
  const RX_KEY = /\b[A-Z][A-Z0-9]+-\d+\b/;
  const isDM   = k => /^DM-\d+$/i.test(k || "");

  function getForm() { return document.querySelector("#worklogForm"); }

  async function isKTAXA() {
    if (S.ktaxa !== null) return S.ktaxa;
    try {
      const r = await fetch("/rest/api/2/myself?expand=groups");
      if (!r.ok) throw 0;
      const me = await r.json();
      const names = (me?.groups?.items || []).map(g => (g?.name || "").toUpperCase());
      S.ktaxa = names.includes(KTAXA_GROUP_NAME.toUpperCase());
    } catch { S.ktaxa = false; }
    return S.ktaxa;
  }

  function extractIssueKeyFromDOM(form) {
    if (!form) return null;
    for (const a of form.querySelectorAll('a[href*="/browse/"]')) {
      const m = (a.getAttribute('href') || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    for (const el of form.querySelectorAll('[data-issue-key],[data-issueKey],[data-testid*="issue"],[data-test-id*="issue"]')) {
      const bag = [
        el.getAttribute('data-issue-key') || '',
        el.getAttribute('data-issueKey')  || '',
        el.getAttribute('data-testid')    || '',
        el.getAttribute('data-test-id')   || '',
        el.textContent || ''
      ].join(' ');
      const m = bag.match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const desc = form.querySelector('#comment, textarea[id*="comment"]');
    if (desc) {
      const m = (desc.value || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const m = (form.textContent || '').match(RX_KEY);
    return m ? m[0].toUpperCase() : null;
  }

  /* ---------- NEW helpers for v6.6 ---------- */
  function getHidden(form, names){
    for (const n of names){
      const el = form?.querySelector?.(`input[name="${n}"], [id="${n}"]`);
      if (el && el.value) return String(el.value).trim();
    }
    return null;
  }

  // Resolve issueKey reliably in Edit modal (Grid/List)
  async function resolveIssueKey(form){
    // 1) Try DOM (links, labels, description)
    const domKey = extractIssueKeyFromDOM(form);
    if (domKey) return domKey;

    // 2) Try hidden fields the modal sometimes renders
    const hiddenKey = getHidden(form, ["issueKey", "issue-key"]);
    if (hiddenKey) return hiddenKey.toUpperCase();

    // 3) Use worklogId -> GET Tempo worklog -> derive key
    const wlId = getHidden(form, ["originId", "worklogId", "worklog-id"]) || S.lastWorklogId;
    if (!wlId) return null;

    if (S.worklogKeyCache.has(wlId)) return S.worklogKeyCache.get(wlId);

    try{
      const r = await fetch(`/rest/tempo-timesheets/4/worklogs/${encodeURIComponent(wlId)}`);
      if (!r.ok) throw 0;
      const j = await r.json();

      let key = (j?.issue?.key) || j?.issueKey || null;
      let iid = (j?.issue?.id)  || j?.issueId   || null;

      if (!key && iid){
        const rx = await fetch(`/rest/api/2/issue/${encodeURIComponent(iid)}?fields=key`);
        if (rx.ok){
          const jj = await rx.json();
          key = (jj?.key) || (jj?.fields?.key) || null;
        }
      }

      if (key){
        key = key.toUpperCase();
        S.worklogKeyCache.set(wlId, key);
        S.lastSeenIssueKey = key;
        return key;
      }
    }catch(e){ /* fail open */ }

    return null;
  }

  function sniffIssueKeyFromURL(url){
    if (!url) return;

    // a) direct ?issueKey=… (create/update from issue view)
    let key = null;
    const mQ = url.match(/[?&]issueKey=([^&#]+)/i);
    if (mQ) key = decodeURIComponent(mQ[1]);

    // b) fallback: /issue/KEY or any KEY in the URL
    if (!key){
      const m1 = url.match(/\/issue\/([A-Z][A-Z0-9]+-\d+)/i);
      key = (m1 && m1[1]) || (url.match(RX_KEY) || [])[0] || null;
    }

    // c) NEW: remember worklogId so we can resolve later (Edit flow)
    const mW = url.match(/\/rest\/tempo-timesheets\/\d+\/worklogs\/(\d+)/i);
    if (mW){
      S.lastWorklogId = mW[1];
      (async () => {
        if (!S.worklogKeyCache.has(S.lastWorklogId)){
          const k = await resolveIssueKey(getForm());
          if (k && getForm()) setTimeout(loadForCurrentForm, 0);
        }
      })();
    }

    if (key){
      key = key.toUpperCase();
      if (S.lastSeenIssueKey !== key){
        S.lastSeenIssueKey = key;
        if (getForm()) setTimeout(loadForCurrentForm, 0);
      }
    }
  }

  /* ---------- DOM task row helpers ---------- */
  function findNativeTaskRow(form) {
    if (!form) return null;
    let lab = form.querySelector(`label[for="${ATTR_KEY}"]`);
    if (!lab) lab = [...form.querySelectorAll("label")]
      .find(l => (l.textContent || "").trim().toLowerCase() === NATIVE_LABEL.toLowerCase());
    if (!lab) return null;
    return lab.closest('[role="group"], .aui-field, .sc-bKhNmF') || lab.parentElement?.parentElement || lab.parentElement;
  }

  function hideNativeTaskRows(form){
    const host = form.querySelector('#custom-workattr-host');
    if (!host) return;

    const ROW_SEL = '[role="group"], .aui-field, .sc-bKhNmF';
    const hostRow = host.closest(ROW_SEL) || host;
    const rows = new Set();

    form.querySelectorAll('label').forEach(lab => {
      const txt = (lab.textContent || '').trim().toLowerCase();
      if (txt !== NATIVE_LABEL.toLowerCase()) return;
      if (lab.closest('#custom-workattr-host')) return;
      const r = lab.closest(ROW_SEL) || lab.parentElement;
      if (r && r !== hostRow) rows.add(r);
    });

    const ctrlSel = [
      `[id="${ATTR_KEY}"]`,
      `[name="${ATTR_KEY}"]`,
      `[aria-label="${NATIVE_LABEL}"]`,
      '[data-test-id*="work-attribute"] select',
      '[data-test-id*="work-attribute"] [role="combobox"]'
    ].join(',');

    form.querySelectorAll(ctrlSel).forEach(ctrl => {
      if (ctrl.closest('#custom-workattr-host')) return;
      const r = ctrl.closest(ROW_SEL) || ctrl.parentElement;
      if (r && r !== hostRow) rows.add(r);
    });

    rows.forEach(r => r.classList.add('workattr-hide-native'));
  }

  function ensureCustomHost(form) {
    if (!form) return null;
    let host = form.querySelector("#custom-workattr-host");
    if (host) return host;

    const nativeRow = findNativeTaskRow(form);
    const insertAfter = nativeRow || form.querySelector('[role="group"], .aui-field, .sc-bKhNmF');
    if (!insertAfter) return null;

    host = document.createElement("div");
    host.id = "custom-workattr-host";
    host.className = "custom-workattr-host";
    host.innerHTML = `
      <label class="custom-workattr-label" for="custom-workattr-select">${CUSTOM_LABEL}</label>
      <select id="custom-workattr-select" class="custom-workattr-select">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" class="custom-workattr-warning" style="display:none;">
        Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.
      </div>
    `;

    if (insertAfter?.parentElement) {
      insertAfter.parentElement.insertBefore(host, insertAfter.nextSibling);
    } else {
      form.appendChild(host);
    }

    hideNativeTaskRows(form);
    setTimeout(() => hideNativeTaskRows(form), 0);
    setTimeout(() => hideNativeTaskRows(form), 250);

    return host;
  }

  function getCustomSelect(form){ return form?.querySelector("#custom-workattr-select") || null; }
  function getWarnBox(form){ return form?.querySelector("#custom-workattr-warning") || null; }

  function getSubmitBtn(form) {
    return form?.querySelector('[name="submitWorklogButton"]')
        || [...(form?.querySelectorAll('button') || [])]
           .find(b => /^(log time|update)$/i.test((b.textContent || '').trim()));
  }

  function fillSelect(select, options, preselect) {
    const keep = new Set();
    select.innerHTML = `<option value="">Select an option...</option>`;
    for (const opt of options) {
      if (!opt || !opt.value) continue;
      if (keep.has(opt.value)) continue;
      keep.add(opt.value);
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.value;
      select.appendChild(o);
    }
    if (preselect && keep.has(preselect)) select.value = preselect;
  }

  /* ---------- Data ---------- */
  function jsonp(url) {
    return new Promise((resolve, reject) => {
      const cb = "tempoWorkAttrCB_" + Math.random().toString(36).slice(2);
      const sep = url.includes("?") ? "&" : "?";
      const src = `${url}${sep}callback=${cb}`;
      const s = document.createElement("script");
      let done = false;

      window[cb] = (data) => { if (done) return; done = true; cleanup(); resolve(data); };
      function cleanup(){ try{delete window[cb]}catch{} s.remove(); }
      s.onerror = () => { if (done) return; done = true; cleanup(); reject(new Error("JSONP failed")); };
      s.src = src;
      document.body.appendChild(s);
    });
  }

  async function fetchOptionsFor(issueKey) {
    if (!issueKey) return [];
    if (S.fetching.has(issueKey)) return S.fetching.get(issueKey);
    const p = (async () => {
      const url = `${JSONP_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`;
      const data = await jsonp(url).catch(() => ({}));
      const list = Array.isArray(data?.values) ? data.values : [];
      return list.map(v => ({ key: v.key, value: v.value }));
    })();
    S.fetching.set(issueKey, p);
    return p;
  }

  async function getIssueMeta(issueKey) {
    if (!issueKey) return { isParent:true, hasAC:true };
    if (S.typeCache.has(issueKey) && S.acCache.has(issueKey)) {
      return { isParent: S.typeCache.get(issueKey), hasAC: S.acCache.get(issueKey) };
    }
    try {
      const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD},issuetype,parent`);
      if (!r.ok) throw 0;
      const j = await r.json();
      const typeName = (j?.fields?.issuetype?.name || "").trim();
      const hasParent = !!j?.fields?.parent;
      const isParent = !(hasParent || EXEMPT_TYPES.has(typeName));
      const acVal = j?.fields?.[AC_FIELD];
      const hasAC = !!(acVal && String(acVal).trim().length > 0);
      S.typeCache.set(issueKey, isParent);
      S.acCache.set(issueKey, hasAC);
      return { isParent, hasAC };
    } catch {
      S.typeCache.set(issueKey, true);
      S.acCache.set(issueKey, true);
      return { isParent:true, hasAC:true };
    }
  }

  /* ---------- Gate (warning + disable) ---------- */
  async function applyGate(form) {
    if (!form) return;

    if (await isKTAXA()) {
      const row = findNativeTaskRow(form);
      if (row) row.classList.remove("workattr-hide-native");
      form.querySelector("#custom-workattr-host")?.remove();
      const warnBox = getWarnBox(form);
      if (warnBox) warnBox.style.display = "none";
      const btn = getSubmitBtn(form); if (btn) { btn.disabled = false; btn.classList.remove("workattr-disabled-btn"); }
      return;
    }

    const key = S.lastIssueKey;
    const select = getCustomSelect(form);
    const warnBox = getWarnBox(form);
    const hasTask = !!(select && select.value);

    let showWarn = false;
    if (key && isDM(key) && !EXEMPT_ISSUES.has(key)) {
      const { isParent, hasAC } = await getIssueMeta(key);
      showWarn = isParent && !hasAC;
    }

    if (warnBox) warnBox.style.display = showWarn ? "block" : "none";

    const btn = getSubmitBtn(form);
    if (btn) {
      const block = showWarn || !hasTask;
      btn.disabled = !!block;
      btn.setAttribute("data-state", block ? "not-active" : "active");
      btn.setAttribute("aria-disabled", String(!!block));
      btn.classList.toggle("workattr-disabled-btn", !!block);
    }
  }

  /* ---------- Main loader ---------- */
  async function loadForCurrentForm() {
    const form = getForm();
    if (!form) return;
    if (S.debounceTimer) clearTimeout(S.debounceTimer);

    S.debounceTimer = setTimeout(async () => {
      const issueKey = (await resolveIssueKey(form)) || S.lastSeenIssueKey;
      if (!issueKey) { warn("issueKey not found"); return; }

      if (S.lastIssueKey !== issueKey) {
        S.lastIssueKey = issueKey;
        S.selection = "";
      }

      if (await isKTAXA()) {
        const row = findNativeTaskRow(form);
        if (row) row.classList.remove("workattr-hide-native");
        form.querySelector("#custom-workattr-host")?.remove();
        const warnBox = getWarnBox(form);
        if (warnBox) warnBox.style.display = "none";
        const btn = getSubmitBtn(form); if (btn) { btn.disabled = false; btn.classList.remove("workattr-disabled-btn"); }
        return;
      }

      onceStyle();
      const host = ensureCustomHost(form);
      if (!host) return;

      const select = getCustomSelect(form);
      if (S.lastOptionsKey !== issueKey) {
        const options = await fetchOptionsFor(issueKey).catch(() => []);
        S.lastOptionsKey = issueKey;
        fillSelect(select, options, S.selection);
      }

      if (!select.__workattrBound) {
        select.__workattrBound = true;
        select.addEventListener("change", () => {
          S.selection = select.value || "";
          applyGate(form);
        });
      }

      await applyGate(form);
    }, OBSERVE_DEBOUNCE_MS);
  }

  /* ---------- Observers ---------- */
  function wireObservers() {
    if (!S.bodyMO) {
      S.bodyMO = new MutationObserver(() => {
        const form = getForm();
        if (form && !S.formMOStarted) {
          if (!S.formMO) S.formMO = new MutationObserver(() => loadForCurrentForm());
          S.formMO.observe(form, { childList: true, subtree: true, characterData: true });
          S.formMOStarted = true;
          loadForCurrentForm();
        } else if (!form && S.formMOStarted) {
          S.formMO.disconnect();
          S.formMOStarted = false;
        }
      });
      S.bodyMO.observe(document.body, { childList: true, subtree: true });
    }
    loadForCurrentForm();
  }

  /* ---------- Injection guards ---------- */
  function looksLikeCreateUpdate(bodyObj) {
    if (!bodyObj || typeof bodyObj !== "object") return false;
    if ("started" in bodyObj) return true;
    if ("timeSpentSeconds" in bodyObj) return true;
    if ("originTaskId" in bodyObj) return true;
    if ("issueId" in bodyObj) return true;
    if ("from" in bodyObj || "to" in bodyObj) return false;
    if ("offset" in bodyObj || "limit" in bodyObj) return false;
    return false;
  }

  /* ---------- Network wiring ---------- */
  function wireNetwork() {
    // XHR
    if (!S.wiredXHR) {
      S.wiredXHR = true;
      const _open = XMLHttpRequest.prototype.open;
      const _send = XMLHttpRequest.prototype.send;

      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        try { sniffIssueKeyFromURL(url); } catch {}
        this.__url = url || "";
        this.__method = (method || "").toUpperCase();
        return _open.call(this, method, url, ...rest);
      };

      XMLHttpRequest.prototype.send = function(body) {
        try {
          if (S.ktaxa === true) return _send.call(this, body);
          const isMutating = /POST|PUT/.test(this.__method || "");
          if (!isMutating || !body || typeof body !== "string") {
            return _send.call(this, body);
          }
          let obj; try { obj = JSON.parse(body); } catch { obj = null; }
          if (looksLikeCreateUpdate(obj)) {
            const form = getForm();
            const sel = form && getCustomSelect(form);
            const chosen = (sel && sel.value) || S.selection || "";
            if (chosen) {
              obj.attributes = obj.attributes || {};
              obj.attributes[ATTR_KEY] = chosen;
              body = JSON.stringify(obj);
              log("✅ Injected into XHR", { [ATTR_KEY]: chosen });
            }
          }
        } catch (e) {
          warn("XHR inject skipped due to error:", e);
        }
        return _send.call(this, body);
      };
    }

    // fetch
    if (!S.wiredFetch && window.fetch) {
      S.wiredFetch = true;
      const _fetch = window.fetch;
      window.fetch = async (input, init = {}) => {
        try {
          const url  = typeof input === "string" ? input : (input?.url || "");
          const meth = (init?.method || "GET").toUpperCase();
          sniffIssueKeyFromURL(url);

          if (S.ktaxa === true) return _fetch(input, init);

          if (/POST|PUT/.test(meth) && init?.body && typeof init.body === "string") {
            let obj; try { obj = JSON.parse(init.body); } catch { obj = null; }
            if (looksLikeCreateUpdate(obj)) {
              const form = getForm();
              const sel = form && getCustomSelect(form);
              const chosen = (sel && sel.value) || S.selection || "";
              if (chosen) {
                obj.attributes = obj.attributes || {};
                obj.attributes[ATTR_KEY] = chosen;
                init = { ...init, body: JSON.stringify(obj) };
                log("✅ Injected into fetch", { [ATTR_KEY]: chosen });
              }
            }
          }
        } catch (e) {
          warn("fetch inject skipped due to error:", e);
        }
        return _fetch(input, init);
      };
    }
  }

  /* ---------- Boot ---------- */
  function boot() {
    onceStyle();
    wireNetwork();
    wireObservers();
    log("Ready (v6.6)");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
