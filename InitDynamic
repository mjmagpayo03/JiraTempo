<script>
/* ========================================================================
   Tempo Task (from API) + Activity Code gate
   Core v4.1.2 — robust dialog/button detection
   ======================================================================== */
const CFG = {
  ATTR_ID: 14,
  ATTR_KEY: "_Picker_",
  ATTR_LABEL: "Task",
  SR_ENDPOINT: "/rest/scriptrunner/latest/custom/tempoWorkType",
  AC_FIELD: "customfield_17447",
  EXEMPT_KEYS: ["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"],
  GATE_PREFIX: /^DM-\d+$/i,
  KTAXA_GROUP: "DM-KTAXA",
  LOG: true
};

const L=(...a)=>CFG.LOG&&console.log("[WorkAttr]",...a);
const W=(...a)=>CFG.LOG&&console.warn("[WorkAttr]",...a);

const S={
  ktaxa:null,
  lastIssueKey:null,
  optionsCache:new Map(),
  selection:null,
  xhrHooked:false
};

const sleep=(ms)=>new Promise(r=>setTimeout(r,ms));
function once(fn){let r=false,v;return(...a)=>r?v:(r=true,(v=fn(...a))); }
function debounce(fn,ms=120){let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms);} }
function throttle(fn,ms=120){let b=false,late;return(...a)=>{if(b){late=a;return;}b=true;fn(...a);setTimeout(()=>{b=false;if(late){const x=late;late=null;fn(...x)}},ms);}}

/* -------------------- JSONP helper -------------------- */
function fetchJSONP(url,param="callback"){
  return new Promise((resolve,reject)=>{
    const cb="tempoWorkAttrCB_"+Math.random().toString(36).slice(2);
    const s=document.createElement("script");
    const done=()=>{s.remove();try{delete window[cb]}catch(e){window[cb]=undefined}};
    window[cb]=(data)=>{done();resolve(data)};
    s.onerror=()=>{done();reject(new Error("JSONP failed "+url))};
    s.src=url+(url.includes("?")?"&":"?")+param+"="+cb;
    document.body.appendChild(s);
  });
}

/* -------------------- REST helpers ------------------- */
async function isUserKTAXA(){
  if(S.ktaxa!==null) return S.ktaxa;
  try{
    const r=await fetch("/rest/api/2/myself?expand=groups");
    const j=await r.json();
    const groups=(j?.groups?.items||[]).map(g=>g.name||g);
    S.ktaxa=groups.some(n=>String(n).toLowerCase()===CFG.KTAXA_GROUP.toLowerCase());
  }catch(e){ W("Group check failed; default non-KTAXA"); S.ktaxa=false; }
  return S.ktaxa;
}
async function hasActivityCode(issueKey){
  try{
    const r=await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${CFG.AC_FIELD}`);
    if(!r.ok) throw 0;
    const j=await r.json();
    const v=j?.fields?.[CFG.AC_FIELD];
    return !!(v && String(v).trim());
  }catch(e){ W("AC check failed; allow"); return true; }
}

/* -------------------- Robust DOM finders -------------- */
// Try several ways to get the open log-work dialog container.
function getForm(){
  // 1) The classic id
  let root=document.querySelector('#worklogForm');
  if(root) return root;

  // 2) From submit button location
  const btn=document.querySelector('button[name="submitWorklogButton"]');
  if(btn){
    root = btn.closest('#worklogForm') ||
           btn.closest('[role="dialog"]') ||
           btn.closest('.aui-dialog2') ||
           btn.closest('div[id]') || btn.closest('div');
    if(root) return root;
  }

  // 3) From a known input in the form (Worked* / Date*)
  const worked=document.querySelector('#timeSpentSeconds,[data-testid="form-prettytime-input"]');
  if(worked){
    root = worked.closest('#worklogForm') ||
           worked.closest('[role="dialog"]') ||
           worked.closest('.aui-dialog2') ||
           worked.closest('div[id]') || worked.closest('div');
    if(root) return root;
  }

  // 4) Last resort: a visible dialog that has heading “Log Time”
  for(const dlg of document.querySelectorAll('[role="dialog"], .aui-dialog2, .modal, .css-1e2kq0x')){
    const h = dlg.querySelector('h2, [data-testid="dialog-title"]');
    if(h && /log\s*time/i.test(h.textContent||"")) return dlg;
  }
  return null;
}

// Extract an issue key by scanning a compact part of the dialog.
function extractIssueKey(form){
  if(!form) return null;

  // Header / selected issue pill
  const header = form.querySelector('header, [data-testid="issue-picker"], [data-testid="selected-issue"]') || form;
  const m1 = header.textContent && header.textContent.match(/[A-Z][A-Z0-9_]+-\d+/i);
  if(m1) return m1[0].toUpperCase();

  // Carefully walk text nodes but limit steps
  const walker=document.createTreeWalker(form, NodeFilter.SHOW_TEXT, null);
  let steps=0, key=null;
  while(walker.nextNode() && steps<4000){
    const t=walker.currentNode.nodeValue;
    const m=t && t.match(/[A-Z][A-Z0-9_]+-\d+/i);
    if(m){ key=m[0].toUpperCase(); break; }
    steps++;
  }
  return key;
}

/* Find native Task row (so we can hide it) */
function findNativeTaskRow(form){
  let lab=form.querySelector('label[for="_Picker_"]');
  if(!lab){
    lab=[...form.querySelectorAll('label')].find(l => l.textContent.trim().toLowerCase()===CFG.ATTR_LABEL.toLowerCase());
  }
  if(!lab) return null;
  return lab.closest('div')?.parentElement || lab.closest('div') || null;
}
function hideNativeTask(form){
  const row=findNativeTaskRow(form);
  if(row){ row.classList.add('workattr-hide-native'); row.style.display='none'; }
}

/* Create / ensure our custom select lives under the Task area */
function ensureCustomField(form){
  let host=form.querySelector('#custom-workattr-host');
  if(host) return host;

  host=document.createElement('div');
  host.id='custom-workattr-host';
  host.style.marginTop='6px';

  const label=document.createElement('div');
  label.textContent=CFG.ATTR_LABEL+" (from API)";
  label.style.fontSize='12px';
  label.style.margin='0 0 4px 2px';
  label.style.color='var(--ds-text-subtlest,#6B778C)';

  const sel=document.createElement('select');
  sel.id='custom-workattr-select';
  sel.style.width='100%'; sel.style.height='36px';
  sel.style.border='1px solid #DFE1E6'; sel.style.borderRadius='4px';
  sel.style.padding='6px 8px';
  sel.innerHTML = `<option value="">Select an option...</option>`;
  sel.addEventListener('change', ()=>{ S.selection = sel.value || null; L("Task selected:", S.selection); });

  host.appendChild(label); host.appendChild(sel);

  const nativeRow=findNativeTaskRow(form);
  if(nativeRow && nativeRow.parentElement){
    nativeRow.parentElement.insertBefore(host,nativeRow.nextSibling);
  }else{
    form.appendChild(host);
  }
  return host;
}
function renderOptions(host, options, keep){
  const sel=host.querySelector('#custom-workattr-select'); if(!sel) return;
  const prior = keep ?? sel.value ?? "";
  sel.innerHTML = `<option value="">Select an option...</option>`;
  for(const o of (options||[])){
    const op=document.createElement('option'); op.value=o.value; op.textContent=o.value; sel.appendChild(op);
  }
  if(prior && [...sel.options].some(x=>x.value===prior)){ sel.value=prior; S.selection=prior; }
  else { sel.value=""; S.selection=null; }
}
async function fetchOptions(issueKey){
  if(S.optionsCache.has(issueKey)) return S.optionsCache.get(issueKey);
  L("▶ Fetching options for", issueKey);
  const data=await fetchJSONP(`${CFG.SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`);
  const values=Array.isArray(data?.values)?data.values:[];
  S.optionsCache.set(issueKey, values);
  return values;
}
function ensureWarning(host){
  let w=host.querySelector('.custom-workattr-warning');
  if(!w){ w=document.createElement('div'); w.className='custom-workattr-warning'; w.style.marginTop='4px'; w.style.fontSize='12px'; w.style.color='#DE350B'; host.appendChild(w); }
  return w;
}

/* ---------------- Submit button hard-disable ---------------- */
function findSubmitBtn(){
  return document.querySelector('button[name="submitWorklogButton"]');
}
function setSubmitDisabled(disabled){
  const btn=findSubmitBtn(); if(!btn) return;

  const stop=(e)=>{ e.stopImmediatePropagation(); e.stopPropagation(); e.preventDefault(); return false; };

  if(disabled){
    btn.disabled=true;
    btn.setAttribute('disabled','');
    btn.setAttribute('data-state','not-active');
    btn.setAttribute('aria-disabled','true');
    btn.style.pointerEvents='none';
    btn.style.opacity='0.6';

    if(!btn.__workattrStopper){ btn.__workattrStopper=stop; btn.addEventListener('click', stop, true); }
    if(!btn.__workattrMO){
      btn.__workattrMO=new MutationObserver(()=>{ // self-heal if Tempo flips it back
        if(!btn.disabled || btn.getAttribute('data-state')!=='not-active'){
          btn.disabled=true;
          btn.setAttribute('disabled','');
          btn.setAttribute('data-state','not-active');
          btn.setAttribute('aria-disabled','true');
          btn.style.pointerEvents='none';
          btn.style.opacity='0.6';
        }
      });
      btn.__workattrMO.observe(btn,{attributes:true,attributeFilter:['disabled','data-state']});
    }
  }else{
    if(btn.__workattrMO){ btn.__workattrMO.disconnect(); btn.__workattrMO=null; }
    if(btn.__workattrStopper){ btn.removeEventListener('click', btn.__workattrStopper, true); btn.__workattrStopper=null; }
    btn.disabled=false;
    btn.removeAttribute('disabled');
    btn.setAttribute('data-state','active');
    btn.setAttribute('aria-disabled','false');
    btn.style.pointerEvents='';
    btn.style.opacity='';
  }
}

/* ----------------- Inject into Tempo POST/PUT ---------------- */
const hookXHR = once(() => {
  if(S.xhrHooked) return; S.xhrHooked=true;
  const _open=XMLHttpRequest.prototype.open;
  const _send=XMLHttpRequest.prototype.send;

  XMLHttpRequest.prototype.open=function(m,u,...rest){
    this.__wx={ m:(m||"").toUpperCase(), u:String(u||"") };
    return _open.call(this,m,u,...rest);
  };
  XMLHttpRequest.prototype.send=function(b){
    try{
      const {m,u}=this.__wx||{};
      const isPOST = m==="POST" && /\/rest\/tempo-timesheets\/\d+\/worklogs\/?$/i.test(u||"");
      const isPUT  = m==="PUT"  && /\/rest\/tempo-timesheets\/\d+\/worklogs\/\d+/.test(u||"");
      if((isPOST||isPUT) && b && S.selection){
        let js;
        if(typeof b==="string"){ try{ js=JSON.parse(b); }catch(e){} }
        if(js){
          js.attributes=js.attributes||{};
          js.attributes[CFG.ATTR_KEY]=S.selection;
          b=JSON.stringify(js);
          L("✅ Injected into XHR", {[CFG.ATTR_KEY]:S.selection});
        }
      }
    }catch(e){}
    return _send.call(this,b);
  };
});

/* ----------------- Main loader for dialog ------------------- */
const loadForCurrentForm = throttle(async function(){
  const form=getForm();
  if(!form) return;

  if(await isUserKTAXA()){ W("KTAXA user — bypass"); return; }

  const issueKey=extractIssueKey(form);
  if(!issueKey){ W("issueKey not found (waiting for selection)"); return; }
  if(S.lastIssueKey===issueKey) return;
  S.lastIssueKey=issueKey;

  hookXHR();
  hideNativeTask(form);
  const host=ensureCustomField(form);

  const opts = await fetchOptions(issueKey);
  renderOptions(host, opts);

  const inScope = CFG.GATE_PREFIX.test(issueKey);
  const exempt  = CFG.EXEMPT_KEYS.includes(issueKey.toUpperCase());
  let block=false, hasAC=true;

  if(inScope && !exempt){
    hasAC = await hasActivityCode(issueKey);
    block = !hasAC;
  }

  L("gate",{key:issueKey, hasAC, exempt, hasTask:!!S.selection, block});

  const warn = ensureWarning(host);
  if(block){
    warn.textContent = "Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.";
    warn.style.display='block';
  }else{
    warn.textContent=""; warn.style.display='none';
  }
  setSubmitDisabled(block);
}, 120);

/* ----------------- Observers & triggers --------------------- */
const arm = once(()=>{
  const mo=new MutationObserver(debounce(loadForCurrentForm,60));
  mo.observe(document.body,{childList:true,subtree:true});
  L("Tempo injector ready");
});
arm();

// Kick on clicks that open/refresh the dialog
document.addEventListener("click",(e)=>{
  const t=e.target;
  if(!t) return;
  if(
    t.closest('[name="logWorkButton"]') ||              // main Log Time button
    t.closest('[data-testid="issue-picker"]') ||        // issue picker open
    t.closest('#worklogForm') ||                        // inside dialog
    t.closest('button[name="submitWorklogButton"]')     // submit button
  ){
    setTimeout(loadForCurrentForm,0);
  }
});

// Reset per dialog close
window.addEventListener("keydown",(e)=>{ if(e.key==="Escape") setTimeout(()=>{S.lastIssueKey=null},0); });
</script>
