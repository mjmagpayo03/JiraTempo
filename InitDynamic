<script>
(() => {
/* ------------ Config ------------ */
const DEBUG = false;
const LOG = (...a) => DEBUG && console.log("[WorkAttr]", ...a);

const TEMPO_ATTR   = { id: 14, key: "_Picker_", label: "Task" };
const SR_ENDPOINT  = "/rest/scriptrunner/latest/custom/tempoWorkType";
const AC_FIELD     = "customfield_17447";
const EXEMPT_ISSUES = new Set(["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"]);
const WARNING_TEXT = "Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.";

/* ------------ State ------------ */
const S = {
  formOpen:false,
  currentIssueKey:null,
  lastKeySig:null,
  userPicking:false,
  savingUntil:0,
  cache:Object.create(null),
  pendingFetch:Object.create(null),
  acCache:Object.create(null),
  acPending:Object.create(null),
  btnObserver:null,
  keyObserver:null,
  btnInterval:null,
  lastEnforceAt:0,
  lastGateSig:null,
  lastBtnDisabled:null,
};

/* ------------ Helpers ------------ */
const now = () => Date.now();
const debounce = (fn, ms) => { let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a), ms); }; };
const throttle = (fn, ms) => { let l=0; return (...a)=>{ const n=now(); if (n-l>=ms){ l=n; fn(...a); } }; };
const hasDMPrefix = k => !!(k && /^DM-\d+$/i.test(k));

const getForm = ()=> document.querySelector("#worklogForm");

/* ---- robust issue key scraping ---- */
function findIssuePickerRoot(form){
  // Try common wrappers near the top of the dialog
  return form.querySelector('[aria-haspopup][aria-expanded]')                                      // react-select button
      || form.querySelector('[role="combobox"]')                                                   // generic combobox
      || form.querySelector('[data-test*="issue"], [data-testid*="issue"]')                        // data-test ids
      || form.querySelector('header + *')                                                          // the first block after header
      || form;                                                                                     // fallback (safe but noisier)
}
function extractKeyFromNode(root){
  const RE = /[A-Z][A-Z0-9]+-\d+/;
  // 1) direct text on the root
  const t0 = (root.textContent || "").trim();
  let m = RE.exec(t0);
  if (m) return m[0].toUpperCase();

  // 2) scan shallow descendants first (fast)
  const kids = [...root.querySelectorAll(":scope > *")];
  for (const el of kids){
    const txt = (el.textContent || "").trim();
    m = RE.exec(txt);
    if (m) return m[0].toUpperCase();
  }

  // 3) broader scan with early stop (still bounded)
  const nodes = [...root.querySelectorAll("*")].slice(0, 200); // cap to avoid heavy reflow
  for (const el of nodes){
    if (!el.firstElementChild && el.textContent){
      m = RE.exec(el.textContent);
      if (m) return m[0].toUpperCase();
    }
  }
  return null;
}
function getIssueKeyFromForm(){
  const f = getForm(); if (!f) return null;
  const root = findIssuePickerRoot(f);
  return extractKeyFromNode(root);
}

/* ---- submit button control ---- */
function findSubmitButtons(){
  const f = getForm(); if (!f) return [];
  let btns = [...f.querySelectorAll('button[name="submitWorklogButton"]')];
  if (btns.length) return btns;
  btns = [...f.querySelectorAll("button")].filter(b => /^(Log Time|Update)$/i.test((b.textContent||"").trim()));
  if (btns.length) return btns;
  const guess = f.querySelector('button[type="button"]');
  return guess ? [guess] : [];
}
function setSubmitDisabled(disabled){
  if (S.lastBtnDisabled === !!disabled) return;
  S.lastBtnDisabled = !!disabled;
  const btns = findSubmitButtons();
  btns.forEach(btn => {
    const d = !!disabled;
    if (btn.disabled !== d) btn.disabled = d;
    if (d) btn.setAttribute("disabled",""); else btn.removeAttribute("disabled");
    btn.setAttribute("aria-disabled", d ? "true" : "false");
    btn.setAttribute("data-state", d ? "not-active" : "active");
    btn.style.pointerEvents = d ? "none" : "";
    btn.classList.toggle("workattr--blocked", d);
    btn.tabIndex = d ? -1 : 0;
  });
}

/* ---- hide native Task & inject our custom one ---- */
function findNativeTaskRow(){
  const f = getForm(); if (!f) return null;
  const label = f.querySelector('label[for="_Picker_"]')
            || [...f.querySelectorAll("label")].find(l => /\bTask\b/i.test(l.textContent||""));
  if (!label) return null;
  return label.closest("div")?.parentElement || label.closest("div");
}
function hideNativeTask(){
  const row = findNativeTaskRow();
  if (row && !row.classList.contains("workattr-hide-native")) row.classList.add("workattr-hide-native");
}
function ensureCustomField(){
  const f = getForm(); if (!f) return null;
  let host = f.querySelector("#custom-workattr-host");
  if (!host){
    host = document.createElement("div");
    host.id = "custom-workattr-host";
    const ref = findNativeTaskRow();
    if (ref && ref.parentElement) ref.parentElement.insertBefore(host, ref);
    else f.appendChild(host);
    host.innerHTML = `
      <label style="display:block;margin-bottom:4px;">Task (from API)</label>
      <select id="custom-workattr-select" style="width:100%;height:32px;">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" style="display:none;color:#d92929;margin-top:6px;font-size:12px;"></div>
    `;
    const sel = host.querySelector("#custom-workattr-select");
    const arm = ()=>{ S.userPicking = true; setTimeout(()=>S.userPicking=false, 800); };
    ["mousedown","focus","click"].forEach(e => sel.addEventListener(e, arm, true));
    sel.addEventListener("change", ()=>{
      window._tempoSelectedWorkAttr = sel.value ? { [TEMPO_ATTR.key]: sel.value } : null;
      enforceSoon();
    });
  }
  return host;
}
const getCustomSelect = ()=> getForm()?.querySelector("#custom-workattr-select") || null;
const getWarningEl    = ()=> getForm()?.querySelector("#custom-workattr-warning") || null;

function fillOptions(values){
  ensureCustomField();
  const sel = getCustomSelect(); if (!sel) return;
  const prev = sel.value;
  const sig  = JSON.stringify(values?.map(v=>v.value) || []);
  if (sel.dataset.sig === sig) return;
  sel.dataset.sig = sig;
  sel.innerHTML = `<option value="">Select an option...</option>`;
  (values||[]).forEach(({value})=>{
    const o = document.createElement("option"); o.value = value; o.textContent = value; sel.appendChild(o);
  });
  if (prev && [...sel.options].some(o=>o.value===prev)) sel.value = prev; else sel.value = "";
  window._tempoSelectedWorkAttr = sel.value ? { [TEMPO_ATTR.key]: sel.value } : null;
}

/* ---- data fetch (deduped) ---- */
function jsonpFetch(issueKey, timeoutMs=8000){
  if (S.pendingFetch[issueKey]) return S.pendingFetch[issueKey];
  const p = new Promise((resolve)=>{
    const cb = `tempoWorkAttrCB_${Math.random().toString(36).slice(2)}`;
    const sc = document.createElement("script"); let done=false;
    const cleanup = ()=>{ if (done) return; done=true; try{ delete window[cb]; }catch{} try{ sc.remove(); }catch{} };
    const timer = setTimeout(()=>{ cleanup(); resolve({values:[]}); }, timeoutMs);
    window[cb] = (data)=>{ clearTimeout(timer); cleanup(); resolve(data||{values:[]}); };
    sc.onerror=()=>{ clearTimeout(timer); cleanup(); resolve({values:[]}); };
    sc.src = `${SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}&callback=${cb}`;
    document.body.appendChild(sc);
  }).then(data=>{
    S.cache[issueKey] = Array.isArray(data?.values) ? data.values : [];
    delete S.pendingFetch[issueKey];
    LOG("options loaded", issueKey, S.cache[issueKey].length);
    return S.cache[issueKey];
  });
  S.pendingFetch[issueKey] = p;
  return p;
}
function getActivityStatus(issueKey){
  if (issueKey in S.acCache) return Promise.resolve(!!S.acCache[issueKey]);
  if (S.acPending[issueKey]) return S.acPending[issueKey];
  const url = `/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`;
  const ctrl = new AbortController(); const t = setTimeout(()=>ctrl.abort(), 7000);
  const p = fetch(url,{signal:ctrl.signal})
    .then(r=>r.ok?r.json():null)
    .then(j=>{ clearTimeout(t); const v=j?.fields?.[AC_FIELD]; const has=!!(v && String(v).trim()); S.acCache[issueKey]=has; return has; })
    .catch(()=>{ clearTimeout(t); S.acCache[issueKey]=false; return false; })
    .finally(()=>{ delete S.acPending[issueKey]; });
  S.acPending[issueKey]=p; return p;
}
async function loadForIssue(issueKey){
  if (!issueKey) return;
  if (!S.cache[issueKey]) await jsonpFetch(issueKey);
  fillOptions(S.cache[issueKey]||[]);
}

/* ---- gating ---- */
async function computeGate(){
  const key = S.currentIssueKey || getIssueKeyFromForm();
  const sel = getCustomSelect();
  const hasTask = !!(sel && sel.value);
  let warn=false, hasAC=true, exempt=false;
  if (hasDMPrefix(key)){
    exempt = EXEMPT_ISSUES.has(key);
    if (!exempt){ hasAC = await getActivityStatus(key); warn = !hasAC; }
  }
  const block = warn || !hasTask;
  return { key, hasTask, hasAC, exempt, block, warn };
}
function startButtonInterval(){
  if (S.btnInterval) return;
  S.btnInterval = setInterval(()=>{
    if (!getForm() || !window._workattr_gate_block){ stopButtonInterval(); return; }
    setSubmitDisabled(true);
  }, 1000);
}
function stopButtonInterval(){ if (S.btnInterval){ clearInterval(S.btnInterval); S.btnInterval=null; } }

const enforce = async () => {
  const f = getForm(); if (!f) return;
  if (now()-S.lastEnforceAt < 250) return; // quicker but still bounded
  S.lastEnforceAt = now();

  const { key, hasTask, hasAC, exempt, block, warn } = await computeGate();
  const sig = `${key}|${warn?'W':'_'}|${hasTask?'T':'_'}|${block?'B':'_'}`;
  if (S.lastGateSig !== sig){ LOG("gate", { key, hasAC, exempt, hasTask, block }); S.lastGateSig = sig; }

  const w = getWarningEl();
  if (w){ if (warn){ w.textContent = WARNING_TEXT; w.style.display="block"; } else { w.textContent=""; w.style.display="none"; } }

  window._workattr_gate_block = !!block;
  setSubmitDisabled(block);
  if (block){ startButtonInterval(); startButtonObserver(); }
  else { stopButtonInterval(); }
};
const enforceSoon = debounce(enforce, 120);

/* ---- observers ---- */
function startKeyObserver(){
  const f = getForm(); if (!f) return;
  const root = findIssuePickerRoot(f);
  if (S.keyObserver){ try{S.keyObserver.disconnect();}catch{} S.keyObserver=null; }
  const obs = new MutationObserver(throttle(()=>{
    const key = getIssueKeyFromForm();
    const sig = key || "none";
    if (sig !== S.lastKeySig){
      S.lastKeySig = sig;
      if (key && key !== S.currentIssueKey && !S.userPicking && now() >= S.savingUntil){
        S.currentIssueKey = key;
        loadForIssue(key);
        enforceSoon();
      }
    }
  }, 150));
  obs.observe(root, { subtree:true, childList:true, characterData:true });
  S.keyObserver = obs;
}
function startButtonObserver(){
  const btns = findSubmitButtons(); if (!btns.length) return;
  if (S.btnObserver){ try{S.btnObserver.disconnect();}catch{} S.btnObserver=null; }
  const obs = new MutationObserver(()=>{
    if (window._workattr_gate_block) setSubmitDisabled(true);
  });
  btns.forEach(b => obs.observe(b, { attributes:true, attributeFilter:["disabled","data-state","class"] }));
  S.btnObserver = obs;
}

/* ---- lifecycle ---- */
function initForm(){
  hideNativeTask();
  ensureCustomField();
  S.lastGateSig = null;
  S.lastBtnDisabled = null;
  S.savingUntil = 0;
  S.userPicking = false;

  const k = getIssueKeyFromForm();
  if (k){ S.currentIssueKey = k; loadForIssue(k); }
  startKeyObserver();
  startButtonObserver();
  enforceSoon();
}

/* ---- global block guards ---- */
function blockEventIfNeeded(ev){
  if (!window._workattr_gate_block) return;
  ev.preventDefault(); ev.stopPropagation();
  const b = findSubmitButtons()[0]; if (b) b.blur();
}
["click","pointerdown"].forEach(evt=>{
  document.addEventListener(evt,(ev)=>{
    const btns = findSubmitButtons();
    if (btns.some(b => b.contains(ev.target))) blockEventIfNeeded(ev);
  }, true);
});
document.addEventListener("keydown",(ev)=>{
  if (ev.key === "Enter" && getForm()) blockEventIfNeeded(ev);
}, true);

/* ---- open/close watcher ---- */
setInterval(()=>{
  const open = !!getForm();
  if (open !== S.formOpen){
    S.formOpen = open;
    if (open) { initForm(); }
    else {
      S.currentIssueKey = null;
      if (S.btnObserver){ try{S.btnObserver.disconnect();}catch{} S.btnObserver=null; }
      if (S.keyObserver){ try{S.keyObserver.disconnect();}catch{} S.keyObserver=null; }
      stopButtonInterval();
    }
  }
}, 700);

/* ---- inject attr & block POST ---- */
const _fetch = window.fetch;
window.fetch = function(url, opts, ...rest){
  try{
    if (typeof url === "string" && url.includes("/rest/tempo-timesheets/4/worklogs/") && opts && typeof opts.body === "string"){
      if (window._workattr_gate_block){
        LOG("blocked POST while gate active");
        return Promise.resolve(new Response(JSON.stringify({blocked:true}), {status:400, headers:{"Content-Type":"application/json"}}));
      }
      const chosen = window._tempoSelectedWorkAttr && window._tempoSelectedWorkAttr[TEMPO_ATTR.key];
      if (chosen){
        const b = JSON.parse(opts.body || "{}");
        b.attributes = b.attributes || {};
        b.attributes[TEMPO_ATTR.id] = chosen;
        opts.body = JSON.stringify(b);
        LOG("injected attr into POST", b.attributes);
      }
    }
  }catch(e){}
  return _fetch.apply(this, [url, opts, ...rest]);
};

/* ---- styles ---- */
const css = document.createElement("style");
css.textContent = `
  .workattr-hide-native{display:none!important}
  #custom-workattr-host{margin-top:8px}
  button.workattr--blocked{opacity:.55;pointer-events:none}
`;
document.head.appendChild(css);

LOG("Banner v3.9.5 key-detect loaded");
})();
</script>
