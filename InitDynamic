<script>
(() => {
  /* ============================================================
   * Tempo Work Attribute Helper — Core v5.3 (Prod)
   * - Warning-only (no button disable)
   * - KTAXA bypass
   * - JSONP Task options
   * - DOM + network discovery of issueKey
   * - NEW: label is "Task" (no "(from API)")
   * - NEW: when editing from grid, resolve issueKey via worklogId
   * ============================================================ */

  /* ---------- Config (PROD) ---------- */
  const ATTR_ID        = 14;             // keep if unchanged in prod
  const ATTR_KEY       = "_Task_";       // prod key
  const NATIVE_LABEL   = "Task";
  const CUSTOM_LABEL   = "Task";         // <— no “(from API)”
  const JSONP_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD       = "customfield_17447";     // Activity Code
  const AC_WARN_TEXT   =
    'Log Time is disabled since Activity Code is not yet available. ' +
    'Please select your Domain BAU demand to log it temporarily to BAU.';
  // prod exemptions list you gave me
  const EXEMPT_ISSUES  = new Set([
    "DM-50267","DM-50235","DM-50236","DM-50237","DM-50238","DM-50239","DM-50240","DM-50241",
    "DM-47398","DM-50242","DM-50243","DM-50234","DM-50233","DM-50244","DM-50245","DM-50246",
    "DM-47406","DM-47407","DM-47408","DM-47409","DM-47410","DM-47484","DM-47391","DM-47392",
    "DM-47394","DM-47395","DM-47671","DM-47396","DM-47397","DM-47399","DM-47400","DM-47401",
    "DM-47402","DM-47403","DM-47404","DM-47405"
  ]);
  const KTAXA_GROUP_NAME   = "DM-KTAXA";
  const OBSERVE_DEBOUNCE_MS = 120;

  /* ---------- State ---------- */
  const S = {
    ktaxa: null,
    lastIssueKey: null,
    lastSeenIssueKey: null,
    lastOptionsKey: null,
    selection: "",
    fetching: new Map(),     // issueKey -> Promise of options
    acCache: new Map(),      // issueKey -> boolean (has AC)
    jiraCache: new Map(),    // issueKey -> Jira issue JSON (issuetype, parent, etc)
    wiredXHR: false,
    wiredFetch: false,
    bodyMO: null,
    formMO: null,
    formMOStarted: false,
    debounceTimer: null
  };

  const log  = (...a) => console.log("%c[WorkAttr]", "color:#2aa", ...a);
  const warn = (...a) => console.warn("%c[WorkAttr]", "color:#d80", ...a);

  /* ---------- CSS ---------- */
  function onceStyle() {
    if (document.getElementById("workattr-style")) return;
    const css = `
      .workattr-hide-native{ display:none !important; }
      .custom-workattr-host{ margin:0 0 8px; }
      .custom-workattr-label{ font-weight:600; display:block; margin-bottom:6px; }
      .custom-workattr-select{ width:100%; height:40px; }
      .custom-workattr-warning{ color:#c00; font-size:.85rem; margin-top:6px; }
    `;
    const el = document.createElement("style");
    el.id = "workattr-style";
    el.textContent = css;
    document.head.appendChild(el);
  }

  /* ---------- Basics ---------- */
  const RX_KEY = /\b[A-Z][A-Z0-9]+-\d+\b/;
  const isDM   = k => /^DM-\d+$/i.test(k || "");

  function getForm(){ return document.querySelector("#worklogForm"); }

  async function isKTAXA() {
    if (S.ktaxa !== null) return S.ktaxa;
    try {
      const r = await fetch("/rest/api/2/myself?expand=groups");
      if (!r.ok) throw 0;
      const me = await r.json();
      const names = (me?.groups?.items || []).map(g => (g?.name || "").toUpperCase());
      S.ktaxa = names.includes(KTAXA_GROUP_NAME.toUpperCase());
    } catch { S.ktaxa = false; }
    return S.ktaxa;
  }

  /* ---------- Resolve issueKey ---------- */
  function extractIssueKeyFromDOM(form) {
    if (!form) return null;

    // typical anchor chip inside the dialog
    for (const a of form.querySelectorAll('a[href*="/browse/"]')) {
      const m = (a.getAttribute("href") || "").match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }

    // any element with likely data attributes
    for (const el of form.querySelectorAll('[data-issue-key],[data-issueKey],[data-testid*="issue"],[data-test-id*="issue"]')) {
      const bag = [
        el.getAttribute("data-issue-key") || "",
        el.getAttribute("data-issueKey")  || "",
        el.getAttribute("data-testid")    || "",
        el.getAttribute("data-test-id")   || "",
        el.textContent || ""
      ].join(" ");
      const m = bag.match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }

    // sometimes description carries "Working on issue KEY"
    const desc = form.querySelector('#comment, textarea[id*="comment"]');
    if (desc) {
      const m = (desc.value || "").match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }

    // final try within dialog text
    const m = (form.textContent || "").match(RX_KEY);
    return m ? m[0].toUpperCase() : null;
  }

  function sniffIssueKeyFromURL(url) {
    if (!url) return;
    let key = null;
    const mQ = url.match(/[?&]issueKey=([^&#]+)/i);
    if (mQ) key = decodeURIComponent(mQ[1]);
    else {
      const m1 = url.match(/\/issue\/([A-Z][A-Z0-9]+-\d+)/i);
      key = (m1 && m1[1]) || (url.match(RX_KEY) || [])[0] || null;
    }
    if (key) {
      key = key.toUpperCase();
      if (S.lastSeenIssueKey !== key) {
        S.lastSeenIssueKey = key;
        if (getForm()) setTimeout(loadForCurrentForm, 0);
      }
    }
  }

  // NEW: if editing from grid, use worklogId to fetch its issue key
  async function resolveIssueKeyViaWorklogId(form) {
    const wlId = form?.getAttribute("data-worklog-id");
    if (!wlId) return null;

    const tries = [
      `/rest/tempo-timesheets/4/worklogs/${wlId}`,
      `/rest/tempo-core/4/worklogs/${wlId}`,
      `/rest/tempo-core/3/worklogs/${wlId}`,
      `/rest/tempo-core/1/worklogs/${wlId}`
    ];
    for (const url of tries) {
      try {
        const r = await fetch(url, { credentials: "same-origin" });
        if (!r.ok) continue;
        const j = await r.json();
        const key =
          (j?.issue && (j.issue.key || j.issue?.issueKey)) ||
          j?.issueKey ||
          j?.key || null;
        if (key) return String(key).toUpperCase();
      } catch {}
    }
    return null;
  }

  /* ---------- DOM task row ---------- */
  function findNativeTaskRow(form) {
    if (!form) return null;
    let lab = form.querySelector(`label[for="${ATTR_KEY}"]`);
    if (!lab) lab = [...form.querySelectorAll("label")]
      .find(l => (l.textContent || "").trim().toLowerCase() === NATIVE_LABEL.toLowerCase());
    if (!lab) return null;
    return lab.closest(".sc-bKhNmF") || lab.parentElement?.parentElement || lab.parentElement;
  }

  function ensureCustomHost(form) {
    if (!form) return null;
    let host = form.querySelector("#custom-workattr-host");
    if (host) return host;

    const row = findNativeTaskRow(form);
    if (!row) return null;

    // hide native Tempo field
    row.classList.add("workattr-hide-native");

    host = document.createElement("div");
    host.id = "custom-workattr-host";
    host.className = "custom-workattr-host";
    host.innerHTML = `
      <label class="custom-workattr-label" for="custom-workattr-select">${CUSTOM_LABEL}</label>
      <select id="custom-workattr-select" class="custom-workattr-select">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" class="custom-workattr-warning" style="display:none;">${AC_WARN_TEXT}</div>
    `;
    row.parentElement?.insertBefore(host, row.nextSibling);
    return host;
  }

  function getCustomSelect(form){ return form?.querySelector("#custom-workattr-select") || null; }
  function getWarnBox(form){ return form?.querySelector("#custom-workattr-warning") || null; }

  function fillSelect(select, options, preselect) {
    const keep = new Set();
    select.innerHTML = `<option value="">Select an option...</option>`;
    for (const opt of options) {
      if (!opt || !opt.value) continue;
      if (keep.has(opt.value)) continue;
      keep.add(opt.value);
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.value;
      select.appendChild(o);
    }
    if (preselect && keep.has(preselect)) select.value = preselect;
  }

  /* ---------- Data ---------- */
  function jsonp(url) {
    return new Promise((resolve, reject) => {
      const cb = "tempoWorkAttrCB_" + Math.random().toString(36).slice(2);
      const sep = url.includes("?") ? "&" : "?";
      const src = `${url}${sep}callback=${cb}`;
      const s = document.createElement("script");
      let done = false;

      window[cb] = (data) => { if (done) return; done = true; cleanup(); resolve(data); };
      function cleanup(){ try{delete window[cb]}catch{} s.remove(); }
      s.onerror = () => { if (done) return; done = true; cleanup(); reject(new Error("JSONP failed")); };
      s.src = src;
      document.body.appendChild(s);
    });
  }

  async function fetchOptionsFor(issueKey) {
    if (!issueKey) return [];
    if (S.fetching.has(issueKey)) return S.fetching.get(issueKey);
    const p = (async () => {
      const url = `${JSONP_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`;
      const data = await jsonp(url).catch(() => ({}));
      const list = Array.isArray(data?.values) ? data.values : [];
      return list.map(v => ({ key: v.key, value: v.value }));
    })();
    S.fetching.set(issueKey, p);
    return p;
  }

  async function getJiraIssue(issueKey) {
    if (!issueKey) return null;
    if (S.jiraCache.has(issueKey)) return S.jiraCache.get(issueKey);
    try {
      // pull Activity Code + type + parent in one call
      const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD},issuetype,parent`);
      if (!r.ok) throw 0;
      const j = await r.json();
      S.jiraCache.set(issueKey, j);
      return j;
    } catch { return null; }
  }

  async function hasActivityCode(issueKey) {
    if (!issueKey) return false;
    if (S.acCache.has(issueKey)) return S.acCache.get(issueKey);

    let ok = true;
    try {
      const j = await getJiraIssue(issueKey);
      const v = j?.fields?.[AC_FIELD];
      ok = !!(v && String(v).trim().length > 0);
    } catch {
      // fail-open if Jira lookup hiccups
      ok = true;
    }
    S.acCache.set(issueKey, ok);
    return ok;
  }

  async function isSubtaskOrCR(issueKey) {
    const j = await getJiraIssue(issueKey);
    const typeName = (j?.fields?.issuetype?.name || "").toLowerCase();
    const hasParent = !!j?.fields?.parent;
    return hasParent || /change\s*request/i.test(typeName);
  }

  /* ---------- Warning-only gate ---------- */
  async function applyGate(form) {
    if (!form) return;

    // KTAXA: show native Task, no warning
    if (await isKTAXA()) {
      const row = findNativeTaskRow(form);
      if (row) row.classList.remove("workattr-hide-native");
      form.querySelector("#custom-workattr-host")?.remove();
      const warnBox = getWarnBox(form);
      if (warnBox) warnBox.style.display = "none";
      return;
    }

    const key = S.lastIssueKey;
    const warnBox = getWarnBox(form);
    if (!key) { if (warnBox) warnBox.style.display = "none"; return; }

    // Show warning only for DM parent issues not in exemption list
    if (isDM(key) && !EXEMPT_ISSUES.has(key)) {
      const skip = await isSubtaskOrCR(key);      // no warning for subtasks/CR
      if (skip) { if (warnBox) warnBox.style.display = "none"; return; }

      const ac = await hasActivityCode(key);
      const show = !ac;
      if (warnBox) warnBox.style.display = show ? "block" : "none";
    } else {
      if (warnBox) warnBox.style.display = "none";
    }
  }

  /* ---------- Main loader ---------- */
  async function loadForCurrentForm() {
    const form = getForm();
    if (!form) return;
    if (S.debounceTimer) clearTimeout(S.debounceTimer);

    S.debounceTimer = setTimeout(async () => {
      // 1) try DOM
      let issueKey = extractIssueKeyFromDOM(form);

      // 2) fall back to last sniffed
      if (!issueKey) issueKey = S.lastSeenIssueKey || null;

      // 3) NEW: if still not found (typical when editing from grid), use worklogId lookup
      if (!issueKey) issueKey = await resolveIssueKeyViaWorklogId(form);

      if (!issueKey) { warn("issueKey not found"); return; }

      if (S.lastIssueKey !== issueKey) {
        S.lastIssueKey = issueKey;
        S.selection = "";
      }

      if (await isKTAXA()) {
        const row = findNativeTaskRow(form);
        if (row) row.classList.remove("workattr-hide-native");
        form.querySelector("#custom-workattr-host")?.remove();
        const warnBox = getWarnBox(form);
        if (warnBox) warnBox.style.display = "none";
        return;
      }

      onceStyle();
      const host = ensureCustomHost(form);
      if (!host) return;

      const select = getCustomSelect(form);
      if (S.lastOptionsKey !== issueKey) {
        const options = await fetchOptionsFor(issueKey).catch(() => []);
        S.lastOptionsKey = issueKey;
        fillSelect(select, options, S.selection);
      }

      if (!select.__workattrBound) {
        select.__workattrBound = true;
        select.addEventListener("change", () => {
          S.selection = select.value || "";
          applyGate(form);
        });
      }

      await applyGate(form);
    }, OBSERVE_DEBOUNCE_MS);
  }

  /* ---------- Observers ---------- */
  function wireObservers() {
    if (!S.bodyMO) {
      S.bodyMO = new MutationObserver(() => {
        const form = getForm();
        if (form && !S.formMOStarted) {
          if (!S.formMO) S.formMO = new MutationObserver(() => loadForCurrentForm());
          S.formMO.observe(form, { childList: true, subtree: true, characterData: true });
          S.formMOStarted = true;
          loadForCurrentForm();
        } else if (!form && S.formMOStarted) {
          S.formMO.disconnect();
          S.formMOStarted = false;
        }
      });
      S.bodyMO.observe(document.body, { childList: true, subtree: true });
    }
    loadForCurrentForm();
  }

  /* ---------- Injection guards (keep) ---------- */
  function looksLikeCreateUpdate(bodyObj) {
    if (!bodyObj || typeof bodyObj !== "object") return false;
    if ("started" in bodyObj) return true;
    if ("timeSpentSeconds" in bodyObj) return true;
    if ("originTaskId" in bodyObj) return true;
    if ("issueId" in bodyObj) return true;
    if ("from" in bodyObj || "to" in bodyObj) return false;
    if ("offset" in bodyObj || "limit" in bodyObj) return false;
    return false;
  }

  /* ---------- Network wiring (kept; no disable) ---------- */
  function wireNetwork() {
    // XHR
    if (!S.wiredXHR) {
      S.wiredXHR = true;
      const _open = XMLHttpRequest.prototype.open;
      const _send = XMLHttpRequest.prototype.send;

      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        try { sniffIssueKeyFromURL(url); } catch {}
        this.__url = url || "";
        this.__method = (method || "").toUpperCase();
        return _open.call(this, method, url, ...rest);
      };

      XMLHttpRequest.prototype.send = function(body) {
        try {
          if (S.ktaxa === true) return _send.call(this, body);
          const isMutating = /POST|PUT/.test(this.__method || "");
          if (!isMutating || !body || typeof body !== "string") {
            return _send.call(this, body);
          }
          let obj; try { obj = JSON.parse(body); } catch { obj = null; }
          if (looksLikeCreateUpdate(obj)) {
            const form = getForm();
            const sel = form && getCustomSelect(form);
            const chosen = (sel && sel.value) || S.selection || "";
            if (chosen) {
              obj.attributes = obj.attributes || {};
              obj.attributes[ATTR_KEY] = chosen;
              body = JSON.stringify(obj);
              log("✅ Injected into XHR", { [ATTR_KEY]: chosen });
            }
          }
        } catch (e) { warn("XHR inject skipped:", e); }
        return _send.call(this, body);
      };
    }

    // fetch
    if (!S.wiredFetch && window.fetch) {
      S.wiredFetch = true;
      const _fetch = window.fetch;
      window.fetch = async (input, init = {}) => {
        try {
          const url  = typeof input === "string" ? input : (input?.url || "");
          const meth = (init?.method || "GET").toUpperCase();
          sniffIssueKeyFromURL(url);

          if (S.ktaxa === true) return _fetch(input, init);

          if (/POST|PUT/.test(meth) && init?.body && typeof init.body === "string") {
            let obj; try { obj = JSON.parse(init.body); } catch { obj = null; }
            if (looksLikeCreateUpdate(obj)) {
              const form = getForm();
              const sel = form && getCustomSelect(form);
              const chosen = (sel && sel.value) || S.selection || "";
              if (chosen) {
                obj.attributes = obj.attributes || {};
                obj.attributes[ATTR_KEY] = chosen;
                init = { ...init, body: JSON.stringify(obj) };
                log("✅ Injected into fetch", { [ATTR_KEY]: chosen });
              }
            }
          }
        } catch (e) { warn("fetch inject skipped:", e); }
        return _fetch(input, init);
      };
    }
  }

  /* ---------- Boot ---------- */
  function boot() {
    onceStyle();
    wireNetwork();
    wireObservers();
    log("Ready (v5.3)");
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
