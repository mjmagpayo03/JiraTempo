<script>
(() => {
  const LOG = (...a) => console.log("[WorkAttr]", ...a);

  // ---------------- CONFIG ----------------
  const TEMPO_ATTR = { id: 14, key: "_Picker_", label: "Task" };
  const SR_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const EXEMPT_ISSUES = new Set(["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"]); // inc. DM-36382

  // ---------------- STATE -----------------
  const S = {
    formOpen: false,
    currentIssueKey: null,
    lastFilledKey: null,
    cache: Object.create(null),          // issueKey -> [{key,value},...]
    userPicking: false,                   // while user interacts with our select
    savingUntil: 0,                       // pause window after clicking “Log Time/Update”
    host: null,
  };

  // -------------- UTILS -------------------
  const debounce = (fn, ms=250) => { let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a), ms); }; };
  const now = () => Date.now();

  // Find issue key currently in the dialog
  function getIssueKeyFromForm() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;

    // Look for something that contains "KEY-1234"
    const m = (form.textContent || "").match(/[A-Z][A-Z0-9]+-\d+/);
    return m ? m[0].toUpperCase() : null;
  }

  // Should we show the “Activity Code” warning?
  function shouldWarn(issueKey) {
    return !!(issueKey && /^DM-\d+$/i.test(issueKey) && !EXEMPT_ISSUES.has(issueKey));
  }

  function ensureWarningEl(form) {
    let warn = form.querySelector('#custom-workattr-warning');
    if (!warn) {
      warn = document.createElement('div');
      warn.id = 'custom-workattr-warning';
      warn.style.cssText = 'color:#d92929;margin:6px 0 0 0;font-size:12px;display:none;';
      // put it just under our custom field if present, else at form end
      const anchor = form.querySelector('#custom-workattr-host') || form.lastElementChild;
      (anchor?.parentElement || form).appendChild(warn);
    }
    return warn;
  }

  function setWarning(issueKey) {
    const form = document.querySelector("#worklogForm");
    if (!form) return;
    const el = ensureWarningEl(form);
    const show = shouldWarn(issueKey);
    el.style.display = show ? 'block' : 'none';
    if (show) {
      el.textContent = "Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.";
    }
  }

  function findNativeTaskRow() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;
    const label = form.querySelector('label[for="_Picker_"]')
      || [...form.querySelectorAll('label')].find(l => /\bTask\b/i.test(l.textContent||""));
    if (!label) return null;
    return label.closest('div')?.parentElement || label.closest('div');
  }

  function hideNativeTask() {
    const row = findNativeTaskRow();
    if (row && !row.classList.contains('workattr-hide-native')) {
      row.classList.add('workattr-hide-native');
    }
  }

  function ensureCustomField() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;

    let host = form.querySelector('#custom-workattr-host');
    if (!host) {
      host = document.createElement('div');
      host.id = 'custom-workattr-host';
      host.className = 'sc-bwANAz';
      const ref = findNativeTaskRow();
      if (ref && ref.parentElement) {
        ref.parentElement.insertBefore(host, ref);
      } else {
        form.appendChild(host);
      }
      host.innerHTML = `
        <label style="display:block;margin-bottom:4px;">Task (from API)</label>
        <select id="custom-workattr-select" style="width:100%;height:32px;">
          <option value="">Select an option...</option>
        </select>
      `;
      const sel = host.querySelector('#custom-workattr-select');

      // Freeze refresh while interacting
      const arm = () => {
        S.userPicking = true;
        setTimeout(() => (S.userPicking = false), 900);
      };
      ['mousedown','focus','click'].forEach(evt => sel.addEventListener(evt, arm, true));

      sel.addEventListener('change', () => {
        const v = sel.value || "";
        if (!v) return;
        window._tempoSelectedWorkAttr = { [TEMPO_ATTR.key]: v };
        LOG("Selected:", v);
      });

      // Pause any re-fetch while saving
      const submitBtn = form.querySelector('button[name="submitWorklogButton"]');
      if (submitBtn && !submitBtn.dataset.workattrHooked) {
        submitBtn.dataset.workattrHooked = "1";
        submitBtn.addEventListener('click', () => {
          S.savingUntil = now() + 4000;   // give Tempo time to post & close
        }, true);
      }
    }

    S.host = host;
    return host;
  }

  function fillOptions(issueKey, values) {
    const host = ensureCustomField();
    if (!host) return;

    const sel = host.querySelector('#custom-workattr-select');
    const prev = sel.value;

    // Only rebuild if options actually changed
    const keySig = JSON.stringify(values?.map(v => v.value) || []);
    if (sel.dataset.sig === keySig) {
      return;
    }
    sel.dataset.sig = keySig;

    sel.innerHTML = `<option value="">Select an option...</option>`;
    (values || []).forEach(({ value }) => {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = value;
      sel.appendChild(opt);
    });

    // Keep previous selection if still valid
    if (prev && [...sel.options].some(o => o.value === prev)) {
      sel.value = prev;
    } else {
      sel.value = "";
      window._tempoSelectedWorkAttr = null;
    }
  }

  // JSONP with timeout protection
  function jsonpFetch(issueKey, timeoutMs = 8000) {
    return new Promise((resolve) => {
      const cb = `tempoWorkAttrCB_${Math.random().toString(36).slice(2)}`;
      const scr = document.createElement('script');
      let done = false;

      const cleanup = () => {
        if (done) return;
        done = true;
        delete window[cb];
        scr.remove();
      };

      const to = setTimeout(() => {
        cleanup();
        resolve({ values: [] });
      }, timeoutMs);

      window[cb] = (data) => {
        clearTimeout(to);
        cleanup();
        resolve(data || { values: [] });
      };

      scr.onerror = () => {
        clearTimeout(to);
        cleanup();
        resolve({ values: [] });
      };

      scr.src = `${SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}&callback=${cb}`;
      document.body.appendChild(scr);
    });
  }

  const loadForIssue = debounce(async (issueKey) => {
    if (!issueKey) return;
    if (S.userPicking || now() < S.savingUntil) return;

    // Use cache if present
    if (S.cache[issueKey]) {
      fillOptions(issueKey, S.cache[issueKey]);
      return;
    }

    LOG("Fetching options for", issueKey);
    const data = await jsonpFetch(issueKey);
    const values = Array.isArray(data?.values) ? data.values : [];
    S.cache[issueKey] = values;
    fillOptions(issueKey, values);
  }, 200);

  function initFormOnceOpen() {
    const form = document.querySelector("#worklogForm");
    if (!form) return;

    hideNativeTask();
    ensureCustomField();

    const key = getIssueKeyFromForm();
    if (key && key !== S.currentIssueKey) {
      S.currentIssueKey = key;
      setWarning(key);
      loadForIssue(key);
    }
  }

  // A light polling loop – avoids heavy MutationObserver churn
  setInterval(() => {
    const form = document.querySelector("#worklogForm");
    const open = !!form;
    if (open !== S.formOpen) {
      S.formOpen = open;
      if (open) {
        // reset per-open flags
        S.userPicking = false;
        S.savingUntil = 0;
        initFormOnceOpen();
      } else {
        // clear transient state when dialog closes
        S.currentIssueKey = null;
        S.host = null;
      }
    } else if (open) {
      // while open, check if issue changed (e.g., user picked a different issue)
      const key = getIssueKeyFromForm();
      if (key && key !== S.currentIssueKey && now() >= S.savingUntil && !S.userPicking) {
        S.currentIssueKey = key;
        setWarning(key);
        loadForIssue(key);
      }
    }
  }, 400);

  // Inject attribute on POST but never throw
  const origFetch = window.fetch;
  window.fetch = function(url, opts, ...rest) {
    try {
      if (typeof url === "string" && url.includes("/rest/tempo-timesheets/4/worklogs/")) {
        if (opts && typeof opts.body === "string" && window._tempoSelectedWorkAttr) {
          const chosen = window._tempoSelectedWorkAttr[TEMPO_ATTR.key];
          if (chosen) {
            try {
              const body = JSON.parse(opts.body);
              body.attributes = body.attributes || {};
              body.attributes[TEMPO_ATTR.id] = chosen; // v4 expects { "14": "value" }
              opts.body = JSON.stringify(body);
              LOG("✅ Injected into XHR POST", body.attributes);
            } catch (_) { /* ignore parse errors, pass-through */ }
          }
        }
      }
    } catch (_) { /* harden against any unexpected shape */ }
    return origFetch.apply(this, [url, opts, ...rest]);
  };

  // Style to hide native row
  const css = document.createElement('style');
  css.textContent = `.workattr-hide-native{display:none!important} #custom-workattr-host{margin-top:8px}`;
  document.head.appendChild(css);

  LOG("Banner v3.2 freeze-safe loaded");
})();
</script>
