<script>
(() => {
  const LOG = (...a) => console.log("[WorkAttr]", ...a);

  // --- CONFIG ---------------------------------------------------------------
  const TEMPO_ATTR = { id: 14, key: "_Picker_", label: "Task" };
  const SR_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  // Issues that must never show the Activity Code warning
  const EXEMPT_ISSUES = new Set(["DM-36231","DM-41282","DM-41281","DM-41280","DM-36382"]);

  // --- state ----------------------------------------------------------------
  const state = {
    currentIssueKey: null,
    lastFetchedKey: null,
    cache: Object.create(null),       // issueKey -> [{key,value},...]
    suppressUntil: 0,                 // time while we ignore observer churn
    userIsPicking: false,             // true when the user is interacting with our select
    mountedHost: null                 // our custom host node
  };

  // Small helper to debounce a function
  const debounce = (fn, ms=300) => {
    let t; return (...args) => { clearTimeout(t); t=setTimeout(()=>fn(...args), ms); };
  };

  // -------------------------- Issue key detection ---------------------------
  function getIssueKeyFromForm() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;

    // Try Tempo’s "selected issue" badge / select first
    // (varies by Tempo build, so keep this generous)
    const candidates = [
      '[data-testid*="issue"]',
      'span[name^="selected_issue_"]',
      'div[role="combobox"]',
      'h2 ~ div', // the line under "Log Time"
    ];

    for (const sel of candidates) {
      const el = form.querySelector(sel);
      if (el) {
        const m = (el.textContent || "").match(/[A-Z][A-Z0-9]+-\d+/);
        if (m) return m[0].toUpperCase();
      }
    }
    // One last broad scan (cheap – form is small)
    const m = (form.textContent || "").match(/[A-Z][A-Z0-9]+-\d+/);
    return m ? m[0].toUpperCase() : null;
  }

  // --------------------------- Warning logic --------------------------------
  function shouldShowActivityWarning(issueKey) {
    // Show only for DM-* and NOT exempted
    return !!(issueKey && /^DM-\d+$/i.test(issueKey) && !EXEMPT_ISSUES.has(issueKey));
  }

  function ensureWarningMount(form) {
    // a simple slim line under our field
    let warn = form.querySelector('#custom-workattr-warning');
    if (!warn) {
      warn = document.createElement('div');
      warn.id = 'custom-workattr-warning';
      warn.style.cssText = 'color:#d92929;margin:6px 0 0 0;font-size:12px;display:none;';
      const after = form.querySelector('#custom-workattr-host') || form.lastElementChild;
      (after?.parentElement || form).appendChild(warn);
    }
    return warn;
  }

  function setWarningVisibility(issueKey) {
    const form = document.querySelector("#worklogForm");
    if (!form) return;
    const warn = ensureWarningMount(form);
    const show = shouldShowActivityWarning(issueKey);
    warn.style.display = show ? 'block' : 'none';
    if (show) {
      warn.textContent =
        "Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.";
    }
  }

  // ------------------------- Custom select field ----------------------------
  function findNativeTaskRow() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;
    // Look for the native Task label row (robust to theme/CSS changes)
    const label =
      form.querySelector('label[for="_Picker_"]') ||
      [...form.querySelectorAll('label')].find(l => /\bTask\b/i.test(l.textContent || ""));
    if (!label) return null;
    // In Tempo’s layout label is in a left column; we want the row wrapper
    const row = label.closest('div')?.parentElement || label.closest('div');
    return row || null;
  }

  function hideNativeTask() {
    const row = findNativeTaskRow();
    if (row) row.classList.add('workattr-hide-native'); // just hides via CSS
    return row;
  }

  function ensureCustomField() {
    const form = document.querySelector("#worklogForm");
    if (!form) return null;
    let host = form.querySelector('#custom-workattr-host');
    if (!host) {
      host = document.createElement('div');
      host.id = 'custom-workattr-host';
      host.className = 'sc-bwANAz';
      // place it where native Task row sits
      const ref = findNativeTaskRow();
      if (ref && ref.parentElement) {
        ref.parentElement.insertBefore(host, ref);
      } else {
        form.appendChild(host);
      }
      state.mountedHost = host;
      buildCustomSelect(host);
    }
    return host;
  }

  function buildCustomSelect(host) {
    host.innerHTML = `
      <label style="display:block;margin-bottom:4px;">Task (from API)</label>
      <select id="custom-workattr-select" style="width:100%;height:32px;">
        <option value="">Select an option...</option>
      </select>
    `;

    // When user opens/clicks/selects, freeze observer-triggered refetches briefly
    const sel = host.querySelector('#custom-workattr-select');
    ['mousedown','focus','click'].forEach(evt =>
      sel.addEventListener(evt, () => {
        state.userIsPicking = true;
        // auto-release shortly after any interaction
        setTimeout(() => (state.userIsPicking = false), 800);
      }, true)
    );

    sel.addEventListener('change', () => {
      const v = sel.value || "";
      if (!v) return;
      // prevent any refresh that reacts to this change
      state.suppressUntil = Date.now() + 1000;

      // Remember selection so our XHR/XFetch injectors can save it
      window._tempoSelectedWorkAttr = { [TEMPO_ATTR.key]: v };

      LOG("Selected:", v);
    });
  }

  function fillOptions(issueKey, values) {
    const host = ensureCustomField();
    if (!host) return;

    const sel = host.querySelector('#custom-workattr-select');
    const prev = sel.value;

    sel.innerHTML = `<option value="">Select an option...</option>`;
    (values || []).forEach(({ value }) => {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = value;
      sel.appendChild(opt);
    });

    // Try keep previous selection if it still exists
    if (prev && [...sel.options].some(o => o.value === prev)) {
      sel.value = prev;
    } else {
      sel.value = ""; // reset
      window._tempoSelectedWorkAttr = null;
    }
  }

  // ------------------------- Data loading & caching -------------------------
  function jsonpFetch(issueKey, cbName) {
    return new Promise((resolve, reject) => {
      const scr = document.createElement('script');
      const cb = `tempoWorkAttrCB_${Math.random().toString(36).slice(2)}`;
      window[cb] = (data) => {
        try { resolve(data); } finally {
          delete window[cb];
          scr.remove();
        }
      };
      scr.onerror = () => { delete window[cb]; reject(new Error("JSONP failed")); };
      scr.src = `${SR_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}&callback=${cb}`;
      document.body.appendChild(scr);
    });
  }

  const loadForIssue = debounce(async (issueKey) => {
    if (!issueKey) return;

    // respect freeze windows (user interaction)
    if (state.userIsPicking || Date.now() < state.suppressUntil) return;

    // nothing to do if we already loaded for this key
    if (state.lastFetchedKey === issueKey && state.cache[issueKey]) {
      fillOptions(issueKey, state.cache[issueKey]);
      return;
    }

    state.lastFetchedKey = issueKey;

    try {
      LOG("Fetching options for", issueKey);
      const data = await jsonpFetch(issueKey);
      const values = (data && data.values) || [];
      state.cache[issueKey] = values;
      fillOptions(issueKey, values);
    } catch (e) {
      console.warn("[WorkAttr] JSONP error", e);
    }
  }, 200);

  // ----------------------------- Wire-up -----------------------------------
  function initForCurrentForm() {
    const form = document.querySelector("#worklogForm");
    if (!form) return;

    // Hide the native field (visual-only)
    hideNativeTask();

    // Ensure our host/field exists
    ensureCustomField();

    // Detect & act on issue key
    const key = getIssueKeyFromForm();
    if (key) {
      if (key !== state.currentIssueKey) {
        state.currentIssueKey = key;
        setWarningVisibility(key);
        loadForIssue(key);
      }
    }
  }

  // Observe the dialog, but filter out noise caused by our own select
  const observeForm = new MutationObserver(() => {
    if (state.userIsPicking || Date.now() < state.suppressUntil) return;
    initForCurrentForm();
  });

  function armObserver() {
    const form = document.querySelector("#worklogForm");
    if (!form) return;
    observeForm.disconnect();
    observeForm.observe(form, { subtree: true, childList: true, characterData: true, attributes: true });
  }

  // When the Tempo dialog is inserted/removed
  const rootObserver = new MutationObserver(() => {
    const form = document.querySelector("#worklogForm");
    if (form) {
      initForCurrentForm();
      armObserver();
    } else {
      observeForm.disconnect();
      // reset form-scoped state
      state.currentIssueKey = null;
      state.mountedHost = null;
      state.userIsPicking = false;
      state.suppressUntil = 0;
    }
  });
  rootObserver.observe(document.body, { childList: true, subtree: true });

  // ---------------------- Inject into POST body -----------------------------
  // Make sure we save the selected Task
  const origFetch = window.fetch;
  window.fetch = function(url, opts, ...rest) {
    try {
      if (typeof url === "string" && url.includes("/rest/tempo-timesheets/4/worklogs/")) {
        if (opts && opts.body && typeof opts.body === "string") {
          const body = JSON.parse(opts.body);
          if (window._tempoSelectedWorkAttr && window._tempoSelectedWorkAttr[TEMPO_ATTR.key]) {
            body.attributes = body.attributes || {};
            // Save as key -> value map per Tempo v4
            body.attributes[TEMPO_ATTR.id] = window._tempoSelectedWorkAttr[TEMPO_ATTR.key];
            opts.body = JSON.stringify(body);
            LOG("✅ Injected into XHR POST", body.attributes);
          }
        }
      }
    } catch(e) { /* no-op */ }
    return origFetch.apply(this, [url, opts, ...rest]);
  };

  // -------------------------- Styles (hide native) --------------------------
  const css = document.createElement("style");
  css.textContent = `
    .workattr-hide-native { display: none !important; }
    #custom-workattr-host { margin-top: 8px; }
  `;
  document.head.appendChild(css);

  LOG("Hotfix v3.1 loaded");
})();
</script>
