<!-- ===== PROD legacy banner behaviors ===== -->
<script type="text/javascript">
(function(){
  const $=(window.AJS&&AJS.$)?AJS.$:(window.jQuery||window.$);
  if(!$){return;}

  function removeIssueType(){
    try{
      const HIDE=new Set(["Onboard Entity User","Onboard Platform User","Defect","Feedback","Epic","Story","Task","Bug"]);
      $(".aui-list-item-link").filter(function(){return HIDE.has($(this).text().trim());}).parent().hide();
    }catch(e){}
  }
  function removeUnwantedIssueTypes(){
    try{
      $("span.drop-menu").off("click.removeIssueType").on("click.removeIssueType",removeIssueType);
      $("#issuetype-field").off(".removeIssueType")
        .on("keyup.removeIssueType",removeIssueType)
        .on("click.removeIssueType",()=>setTimeout(removeIssueType,1));
      $("#project").off("change.removeIssueType").on("change.removeIssueType",()=>{ setTimeout(()=>{ if(typeof window.findIssueType==="function"){window.findIssueType();} else {removeIssueType();} },1000); });
    }catch(e){}
  }
  function overwriteNewDemandNames(){
    try{
      const url=String(window.location.href);
      if(url.includes("&demandnew=true")){ removeUnwantedIssueTypes(); }
      if(url.includes("&demandcustomized=true")){
        const hdr=$(".aui-page-header-inner").get(0);
        if(hdr&&hdr.innerHTML){ hdr.innerHTML=hdr.innerHTML.replace("Create Issue","Create Demand"); }
        $('label[for="issuetype-field"]').text("Demand Type");
        $('label[for="issue-create-issue-type"]').text("Demand Type");
        $('label[for="project-field"]').parent().hide();
        $('label[for="issue-create-project-name"]').parent().hide();
      }else if(url.includes("CreateIssue.jspa")){
        const $projRow=$('label[for="issue-create-project-name"]').parent();
        const projectName=$projRow.children().eq(1).text();
        if(projectName==="Demand Management"||projectName==="Demand Management UAT"){
          const $typeRow=$('label[for="issue-create-issue-type"]').parent();
          const issueType=$typeRow.children().eq(2).text();
          if(issueType==="Service Delivery Demand"||issueType==="Solution Delivery Demand"){
            const hdr=$(".aui-page-header-inner").get(0);
            if(hdr&&hdr.innerHTML){ hdr.innerHTML=hdr.innerHTML.replace("Create Issue","Create Demand"); }
            $projRow.hide();
            $('label[for="issue-create-issue-type"]').text("Demand Type");
          }
        }
      }
    }catch(e){}
  }
  function addCSSRule(sheet,selector,rules,index){
    try{
      if(!sheet) return;
      if("insertRule" in sheet){ sheet.insertRule(`${selector}{${rules}}`,index); }
      else if("addRule" in sheet){ sheet.addRule(selector,rules,index); }
    }catch(e){}
  }
  function hidePriority(){
    try{
      const p=window.location.pathname||"", qs=window.location.search||"";
      const match=p.includes("RapidBoard.jspa") && (/projectKey=(DM|DMUAT|DMSTAGE|KDMSTAGE|KDM|KDMUAT)(&|$)/.test(qs));
      if(match){
        const sheet=(document.styleSheets&&document.styleSheets[0])||null;
        addCSSRule(sheet,".ghx-priority","display: none;",(sheet?.cssRules?.length||0));
      }
    }catch(e){}
  }
  function replaceTAT(){
    try{
      if(window.JIRA&&JIRA.ViewIssueTabs){
        JIRA.ViewIssueTabs.onTabReady(function(){
          const ttsSLA=AJS.$("#tts-sla-panel_heading");
          if(ttsSLA.length && !(ttsSLA.html()||"").includes("TAT Panel")){
            ttsSLA.find(".toggle-title").last().text("TAT Panel");
            ttsSLA.append("<style>.tts-sla-box__sla-prefix{visibility:hidden}.tts-sla-box__sla-prefix:before{content:'TAT';visibility:visible;position:absolute}</style>");
          }
        });
      }
    }catch(e){}
  }
  replaceTAT();
  $(window).on("load",function(){ overwriteNewDemandNames(); hidePriority(); });
})();
</script>

<!-- ===== Tempo Work Attribute Helper — v6.4 ===== -->
<script>
(()=>{

  /* ---------- Config ---------- */
  const ATTR_KEY = "_Task_";            // PROD attribute key
  const NATIVE_LABEL = "Task";
  const CUSTOM_LABEL = "Task";
  const JSONP_ENDPOINT = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD = "customfield_17447";
  const AC_WARN_TEXT = 'Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.';
  const EXEMPT_ISSUES = new Set(["DM-50267","DM-50235","DM-50236","DM-50237","DM-50238","DM-50239","DM-50240","DM-50241","DM-47398","DM-50242","DM-50243","DM-50234","DM-50233","DM-50244","DM-50245","DM-50246","DM-47406","DM-47407","DM-47408","DM-47409","DM-47410","DM-47484","DM-47391","DM-47392","DM-47394","DM-47395","DM-47671","DM-47396","DM-47397","DM-47399","DM-47400","DM-47401","DM-47402","DM-47403","DM-47404","DM-47405"]);
  const KTAXA_GROUP_NAME = "DM-KTAXA";
  const OBSERVE_DEBOUNCE_MS = 120;
  const SENTINEL_MS = 2000;

  /* ---------- State ---------- */
  const S = {
    ktaxa:null,lastIssueKey:null,lastSeenIssueKey:null,lastOptionsKey:null,
    selection:"",fetching:new Map(),acCache:new Map(),typeCache:new Map(),
    wiredXHR:false,wiredFetch:false,bodyMO:null,formMO:null,formMOStarted:false,debounceTimer:null,sentinelTimer:null
  };

  const RX_KEY=/\b[A-Z][A-Z0-9]+-\d+\b/;
  const isDM=k=>/^DM-\d+$/i.test(k||"");
  const getForm=()=>document.querySelector("#worklogForm");
  const safeMatches=(n,s)=>{try{return !!(n&&n.matches&&n.matches(s));}catch{return false;}};

  function sniffIssueKeyFromURL(url){
    if(!url) return;
    let key=null;
    const mQ=url.match(/[?&]issueKey=([^&#]+)/i);
    if(mQ) key=decodeURIComponent(mQ[1]);
    else{ const m1=url.match(/\/issue\/([A-Z][A-Z0-9]+-\d+)/i); key=(m1&&m1[1])||(url.match(RX_KEY)||[])[0]||null; }
    if(key){ key=key.toUpperCase(); if(S.lastSeenIssueKey!==key){ S.lastSeenIssueKey=key; if(getForm()) setTimeout(loadForCurrentForm,0); } }
  }

  function extractIssueKeyFromDOM(form){
    if(!form) return null;
    for(const a of form.querySelectorAll('a[href*="/browse/"]')){ const m=(a.getAttribute('href')||'').match(RX_KEY); if(m) return m[0].toUpperCase(); }
    for(const el of form.querySelectorAll('[data-issue-key],[data-issueKey],[data-testid*="issue"],[data-test-id*="issue"]')){
      const bag=[el.getAttribute('data-issue-key')||'',el.getAttribute('data-issueKey')||'',el.getAttribute('data-testid')||'',el.getAttribute('data-test-id')||'',el.textContent||''].join(' ');
      const m=bag.match(RX_KEY); if(m) return m[0].toUpperCase();
    }
    const desc=form.querySelector('#comment, textarea[id*="comment"]'); if(desc){ const m=(desc.value||'').match(RX_KEY); if(m) return m[0].toUpperCase(); }
    const m=(form.textContent||'').match(RX_KEY); return m?m[0].toUpperCase():null;
  }

  async function isKTAXA(){
    if(S.ktaxa!==null) return S.ktaxa;
    try{
      const r=await fetch("/rest/api/2/myself?expand=groups"); if(!r.ok) throw 0;
      const me=await r.json(); const names=(me?.groups?.items||[]).map(g=>(g?.name||"").toUpperCase());
      S.ktaxa=names.includes(KTAXA_GROUP_NAME.toUpperCase());
    }catch{S.ktaxa=false;}
    return S.ktaxa;
  }

  async function isParentIssue(issueKey){
    if(!issueKey) return true;
    if(S.typeCache.has(issueKey)) return S.typeCache.get(issueKey);
    const val=await (async()=>{
      try{
        const r=await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=issuetype,parent`);
        if(!r.ok) throw 0;
        const j=await r.json();
        const it=j?.fields?.issuetype||{};
        const isSub=!!it?.subtask;
        const name=(it?.name||"").toLowerCase();
        if(isSub) return false;
        if(name==="change request") return false;
        return true;
      }catch{return true;}
    })();
    S.typeCache.set(issueKey,val);
    return val;
  }

  async function hasActivityCode(issueKey){
    if(!issueKey) return false;
    if(S.acCache.has(issueKey)) return S.acCache.get(issueKey);
    const ok=await (async()=>{
      try{
        const r=await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD}`);
        if(!r.ok) throw 0;
        const j=await r.json(); const v=j?.fields?.[AC_FIELD];
        return !!(v && String(v).trim().length>0);
      }catch{ return true; }
    })();
    S.acCache.set(issueKey,ok); return ok;
  }

  /* ===== Row-only hide (no parent climbing) ===== */
  function fieldRow(form, node){
    if(!node) return null;
    const ROW_SEL = '.sc-bKhNmF, .aui-field, [role="group"]';
    let n=node;
    for(let i=0;i<6 && n && n!==form;i++){
      if(n.id==='custom-workattr-host') return null;
      if(safeMatches(n,ROW_SEL) || n.getAttribute?.('role')==='group') return n;
      n=n.parentElement;
    }
    return null;
  }

function hideNativeTaskRows(form){
  const host = form.querySelector('#custom-workattr-host');
  if (!host) return;

  // “Row” = the immediate container that Tempo uses for a field group.
  const ROW_SEL = '[role="group"], .aui-field, .sc-bKhNmF';
  const hostRow = host.closest(ROW_SEL) || host;

  const rows = new Set();

  // 1) Any label that says "Task" (not inside our host)
  form.querySelectorAll('label').forEach(lab => {
    const txt = (lab.textContent || '').trim().toLowerCase();
    if (txt !== NATIVE_LABEL.toLowerCase()) return;
    if (lab.closest('#custom-workattr-host')) return;
    const r = lab.closest(ROW_SEL) || lab.parentElement;
    if (r && r !== hostRow) rows.add(r);
  });

  // 2) Any native control that might render the Task field (list/grid views)
  const ctrlSel = [
    `[id="${ATTR_KEY}"]`,
    `[name="${ATTR_KEY}"]`,
    `[aria-label="${NATIVE_LABEL}"]`,
    '[data-test-id*="work-attribute"] select',
    '[data-test-id*="work-attribute"] [role="combobox"]'
  ].join(',');

  form.querySelectorAll(ctrlSel).forEach(ctrl => {
    if (ctrl.closest('#custom-workattr-host')) return;
    const r = ctrl.closest(ROW_SEL) || ctrl.parentElement;
    if (r && r !== hostRow) rows.add(r);
  });

  rows.forEach(r => r.classList.add('workattr-hide-native'));
}


  function ensureCustomHost(form){
    if(!form) return null;
    let host=form.querySelector("#custom-workattr-host");
    if(host) return host;

    let insertAfter=null;
    for(const lab of form.querySelectorAll('label')){
      const txt=(lab.textContent||'').trim().toLowerCase();
      if(txt===NATIVE_LABEL.toLowerCase()){ insertAfter=fieldRow(form,lab); if(insertAfter) break; }
    }
// after: insert host (same as your current code)
if (insertAfter?.parentElement) {
  insertAfter.parentElement.insertBefore(host, insertAfter.nextSibling);
} else {
  form.appendChild(host);
}

/* NEW: aggressively hide the native row in list view */
hideNativeTaskRows(form);
setTimeout(() => hideNativeTaskRows(form), 0);
setTimeout(() => hideNativeTaskRows(form), 250);

    host=document.createElement("div");
    host.id="custom-workattr-host";
    host.className="custom-workattr-host";
    host.innerHTML=`
      <label class="custom-workattr-label" for="custom-workattr-select">${CUSTOM_LABEL}</label>
      <select id="custom-workattr-select" class="custom-workattr-select">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" class="custom-workattr-warning" style="display:none;">${AC_WARN_TEXT}</div>
    `;

    if(insertAfter?.parentElement){ insertAfter.parentElement.insertBefore(host, insertAfter.nextSibling); }
    else{ form.appendChild(host); }

    setTimeout(()=>hideNativeTaskRows(form),50);
    setTimeout(()=>{
      const s=form.querySelector('#custom-workattr-select');
      if(!s || s.options.length<=1){
        form.querySelectorAll('.workattr-hide-native').forEach(n=>n.classList.remove('workattr-hide-native'));
      }
    },500);
    return host;
  }

  function getCustomSelect(form){ return form?.querySelector("#custom-workattr-select")||null; }
  function getWarnBox(form){ return form?.querySelector("#custom-workattr-warning")||null; }

  function getDialogRoot(form){
    const anchor=form?.querySelector('#custom-workattr-host')||form||document.body;
    return anchor.closest('[role="dialog"], .aui-dialog2, [data-testid*="dialog"], [data-test-id*="dialog"]');
  }
  function getSubmitBtn(form){
    const dlg=getDialogRoot(form); if(!dlg) return null;
    const c=[...dlg.querySelectorAll('button,[role="button"]')];
    return c.find(b=>{
      const t=(b.textContent||'').trim();
      const n=(b.getAttribute('name')||'').toLowerCase();
      return /^(log time|update)$/i.test(t) || n.includes('submitworklogbutton');
    })||null;
  }
  function setSubmitBlocked(form,blocked){
    const btn=getSubmitBtn(form);
    if(btn){
      btn.disabled=!!blocked;
      btn.setAttribute("data-state",blocked?"not-active":"active");
      btn.setAttribute("aria-disabled",String(!!blocked));
      btn.classList.toggle("workattr-disabled-btn",!!blocked);
    }
    if(S.sentinelTimer){clearInterval(S.sentinelTimer);S.sentinelTimer=null;}
    if(blocked){
      const start=Date.now();
      S.sentinelTimer=setInterval(()=>{
        const f=getForm(); if(!f) return;
        const b=getSubmitBtn(f); if(!b) return;
        b.disabled=true;
        b.setAttribute("data-state","not-active");
        b.setAttribute("aria-disabled","true");
        b.classList.add("workattr-disabled-btn");
        if(Date.now()-start>SENTINEL_MS){clearInterval(S.sentinelTimer);S.sentinelTimer=null;}
      },120);
    }
  }

  function fillSelect(select,options,preselect){
    const keep=new Set();
    select.innerHTML=`<option value="">Select an option...</option>`;
    for(const opt of options){
      if(!opt||!opt.value) continue;
      if(keep.has(opt.value)) continue;
      keep.add(opt.value);
      const o=document.createElement("option");
      o.value=opt.value; o.textContent=opt.value;
      select.appendChild(o);
    }
    if(preselect && keep.has(preselect)) select.value=preselect;
  }

  function jsonp(url){
    return new Promise((resolve,reject)=>{
      const cb="tempoWorkAttrCB_"+Math.random().toString(36).slice(2);
      const sep=url.includes("?")?"&":"?";
      const s=document.createElement("script");
      window[cb]=(data)=>{ cleanup(); resolve(data); };
      function cleanup(){ try{delete window[cb]}catch{} s.remove(); }
      s.onerror=()=>{ cleanup(); reject(new Error("JSONP failed")); };
      s.src=`${url}${sep}callback=${cb}`;
      document.body.appendChild(s);
    });
  }

  async function fetchOptionsFor(issueKey){
    if(!issueKey) return [];
    if(S.fetching.has(issueKey)) return S.fetching.get(issueKey);
    const p=(async()=>{
      const url=`${JSONP_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`;
      const data=await jsonp(url).catch(()=>({}));
      const list=Array.isArray(data?.values)?data.values:[];
      return list.map(v=>({key:v.key,value:v.value}));
    })();
    S.fetching.set(issueKey,p);
    return p;
  }

  async function applyGate(form){
    if(!form) return;
    if(await isKTAXA()){
      form.querySelector("#custom-workattr-host")?.remove();
      const warnBox=getWarnBox(form); if(warnBox) warnBox.style.display="none";
      setSubmitBlocked(form,false);
      return;
    }

    const key=S.lastIssueKey;
    const select=getCustomSelect(form);
    const hasTask=!!(select && select.value);
    let showWarn=false;

    if(key && isDM(key) && !EXEMPT_ISSUES.has(key)){
      if(await isParentIssue(key)){
        const ac=await hasActivityCode(key);
        showWarn=!ac;
      }
    }
    const warnBox=getWarnBox(form);
    if(warnBox) warnBox.style.display=showWarn?"block":"none";
    setSubmitBlocked(form, showWarn || !hasTask);
  }

  async function loadForCurrentForm(){
    const form=getForm(); if(!form) return;
    if(S.debounceTimer) clearTimeout(S.debounceTimer);

    S.debounceTimer=setTimeout(async ()=>{
      const issueKey=extractIssueKeyFromDOM(form) || S.lastSeenIssueKey;
      if(!issueKey) return;

      if(S.lastIssueKey!==issueKey){ S.lastIssueKey=issueKey; S.selection=""; }

      const host=ensureCustomHost(form); if(!host) return;

      const select=getCustomSelect(form);
      if(S.lastOptionsKey!==issueKey){
        const options=await fetchOptionsFor(issueKey).catch(()=>[]);
        S.lastOptionsKey=issueKey;
        fillSelect(select,options,S.selection);
      }

      if(!select.__workattrBound){
        select.__workattrBound=true;
        select.addEventListener("change",()=>{ S.selection=select.value||""; applyGate(form); });
      }

      await applyGate(form);
      setTimeout(()=>applyGate(form),80);
    },OBSERVE_DEBOUNCE_MS);
  }

  function looksLikeCreateUpdate(obj){
    if(!obj||typeof obj!=="object") return false;
    if("started" in obj) return true;
    if("timeSpentSeconds" in obj) return true;
    if("originTaskId" in obj) return true;
    if("issueId" in obj) return true;
    if("from" in obj || "to" in obj) return false;
    if("offset" in obj || "limit" in obj) return false;
    return false;
  }

  /* ---------- Network wiring ---------- */
  function adaptAttributesForEndpoint(method,url,obj,chosen){
    const isPUT = method==="PUT";
    const isWorklogEndpoint = /\/rest\/tempo-timesheets\/\d+\/worklogs(\/\d+\/?)?$/i.test(url||"");

    if(!chosen || !isWorklogEndpoint) return obj;

    if(isPUT){
      // Use workAttributeValues for updates; remove attributes to avoid 500
      delete obj.attributes;
      obj.workAttributeValues = [{ key: ATTR_KEY, value: chosen }];
    }else{
      // POST create: keep simple attributes map
      obj.attributes = obj.attributes || {};
      obj.attributes[ATTR_KEY] = chosen;
    }
    return obj;
  }

  function wireNetwork(){
    if(!S.wiredXHR){
      S.wiredXHR=true;
      const _open=XMLHttpRequest.prototype.open;
      const _send=XMLHttpRequest.prototype.send;
      XMLHttpRequest.prototype.open=function(method,url,...rest){
        try{sniffIssueKeyFromURL(url);}catch{}
        this.__url=url||""; this.__method=(method||"").toUpperCase();
        return _open.call(this,method,url,...rest);
      };
      XMLHttpRequest.prototype.send=function(body){
        try{
          if(S.ktaxa===true) return _send.call(this,body);
          const meth=this.__method||"";
          const isMut=/POST|PUT/.test(meth);
          if(!isMut || !body || typeof body!=="string"){return _send.call(this,body);}
          let obj; try{obj=JSON.parse(body);}catch{obj=null;}
          if(looksLikeCreateUpdate(obj)){
            const form=getForm(); const sel=form&&getCustomSelect(form);
            const chosen=(sel&&sel.value)||S.selection||"";
            if(chosen){
              obj = adaptAttributesForEndpoint(meth,this.__url,obj,chosen);
              body=JSON.stringify(obj);
              console.log("%c[WorkAttr]","color:#2aa",`✅ Injected into XHR (${meth})`, /PUT/.test(meth)?{workAttributeValues:obj.workAttributeValues}:{[ATTR_KEY]:chosen});
            }
          }
        }catch(e){ console.warn("%c[WorkAttr]","color:#d80","XHR inject skipped:",e); }
        return _send.call(this,body);
      };
    }
    if(!S.wiredFetch && window.fetch){
      S.wiredFetch=true;
      const _fetch=window.fetch;
      window.fetch=async (input,init={})=>{
        try{
          const url=typeof input==="string"?input:(input?.url||"");
          const meth=(init?.method||"GET").toUpperCase();
          sniffIssueKeyFromURL(url);
          if(S.ktaxa===true) return _fetch(input,init);
          if(/POST|PUT/.test(meth) && init?.body && typeof init.body==="string"){
            let obj; try{obj=JSON.parse(init.body);}catch{obj=null;}
            if(looksLikeCreateUpdate(obj)){
              const form=getForm(); const sel=form&&getCustomSelect(form);
              const chosen=(sel&&sel.value)||S.selection||"";
              if(chosen){
                obj = adaptAttributesForEndpoint(meth,url,obj,chosen);
                init={...init, body:JSON.stringify(obj)};
                console.log("%c[WorkAttr]","color:#2aa",`✅ Injected into fetch (${meth})`, /PUT/.test(meth)?{workAttributeValues:obj.workAttributeValues}:{[ATTR_KEY]:chosen});
              }
            }
          }
        }catch(e){ console.warn("%c[WorkAttr]","color:#d80","fetch inject skipped:",e); }
        return _fetch(input,init);
      };
    }
  }

  function wireObservers(){
    if(!S.bodyMO){
      S.bodyMO=new MutationObserver(()=>{
        const form=getForm();
        if(form && !S.formMOStarted){
          if(!S.formMO) S.formMO=new MutationObserver(()=>loadForCurrentForm());
          S.formMO.observe(form,{childList:true,subtree:true,characterData:true});
          S.formMOStarted=true;
          loadForCurrentForm();
        }else if(!form && S.formMOStarted){
          S.formMO.disconnect();
          S.formMOStarted=false;
        }
      });
      S.bodyMO.observe(document.body,{childList:true,subtree:true});
    }
    loadForCurrentForm();
  }

  function boot(){ wireNetwork(); wireObservers(); console.log("%c[WorkAttr]","color:#2aa","Ready (v6.4)"); }
  if(document.readyState==="loading"){ document.addEventListener("DOMContentLoaded",boot); } else { boot(); }

})();
</script>
