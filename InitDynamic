<!-- ===== PROD legacy banner behaviors (safely wrapped) ===== -->
<script type="text/javascript">
(function(){
  const $ = (window.AJS && AJS.$) ? AJS.$ : (window.jQuery || window.$);
  if (!$) return;

  function removeIssueType(){
    try{
      const HIDE = new Set([
        "Onboard Entity User","Onboard Platform User","Defect","Feedback",
        "Epic","Story","Task","Bug"
      ]);
      $(".aui-list-item-link").filter(function(){
        return HIDE.has($(this).text().trim());
      }).parent().hide();
    }catch(e){}
  }

  function removeUnwantedIssueTypes(){
    try{
      $("span.drop-menu").off("click.removeIssueType").on("click.removeIssueType", removeIssueType);
      $("#issuetype-field")
        .off(".removeIssueType")
        .on("keyup.removeIssueType", removeIssueType)
        .on("click.removeIssueType", () => setTimeout(removeIssueType,1));
      $("#project").off("change.removeIssueType").on("change.removeIssueType", () => {
        setTimeout(() => {
          if (typeof window.findIssueType === "function") { window.findIssueType(); }
          else { removeIssueType(); }
        }, 1000);
      });
    }catch(e){}
  }

  function overwriteNewDemandNames(){
    try{
      const url = String(window.location.href);
      if (url.includes("&demandnew=true")){
        removeUnwantedIssueTypes();
      }
      if (url.includes("&demandcustomized=true")){
        const hdr = $(".aui-page-header-inner").get(0);
        if (hdr && hdr.innerHTML) { hdr.innerHTML = hdr.innerHTML.replace("Create Issue","Create Demand"); }
        $('label[for="issuetype-field"]').text("Demand Type");
        $('label[for="issue-create-issue-type"]').text("Demand Type");
        $('label[for="project-field"]').parent().hide();
        $('label[for="issue-create-project-name"]').parent().hide();
      } else if (url.includes("CreateIssue.jspa")){
        const $projRow = $('label[for="issue-create-project-name"]').parent();
        const projectName = $projRow.children().eq(1).text();
        if (projectName === "Demand Management" || "Demand Management UAT"){
          const $typeRow = $('label[for="issue-create-issue-type"]').parent();
          const issueType = $typeRow.children().eq(2).text();
          if (issueType === "Service Delivery Demand" || issueType === "Solution Delivery Demand"){
            const hdr = $(".aui-page-header-inner").get(0);
            if (hdr && hdr.innerHTML) { hdr.innerHTML = hdr.innerHTML.replace("Create Issue","Create Demand"); }
            $projRow.hide();
            $('label[for="issue-create-issue-type"]').text("Demand Type");
          }
        }
      }
    }catch(e){}
  }

  function addCSSRule(sheet, selector, rules, index){
    try{
      if (!sheet) return;
      if ("insertRule" in sheet) { sheet.insertRule(`${selector}{${rules}}`, index); }
      else if ("addRule" in sheet) { sheet.addRule(selector, rules, index); }
    }catch(e){}
  }

  function hidePriority(){
    try{
      const p = window.location.pathname || "";
      const qs = window.location.search || "";
      const match = p.includes("RapidBoard.jspa") &&
        (/projectKey=(DM|DMUAT|DMSTAGE|KDMSTAGE|KDM|KDMUAT)(&|$)/.test(qs));
      if (match){
        const sheet = (document.styleSheets && document.styleSheets[0]) || null;
        addCSSRule(sheet, ".ghx-priority", "display: none;", (sheet?.cssRules?.length || 0));
      }
    }catch(e){}
  }

  function replaceTAT(){
    try{
      if (window.JIRA && JIRA.ViewIssueTabs){
        JIRA.ViewIssueTabs.onTabReady(function(){
          const ttsSLA = $("#tts-sla-panel_heading");
          if (ttsSLA.length && !(ttsSLA.html() || "").includes("TAT Panel")){
            ttsSLA.find(".toggle-title").last().text("TAT Panel");
            ttsSLA.append("<style>.tts-sla-box__sla-prefix{visibility:hidden}.tts-sla-box__sla-prefix:before{content:'TAT';visibility:visible;position:absolute}</style>");
          }
        });
      }
    }catch(e){}
  }

  replaceTAT();
  $(window).on("load", function(){
    overwriteNewDemandNames();
    hidePriority();
  });
})();
</script>

<!-- ===================== 2) Tempo Work Attribute Helper — v7.1 ===================== -->
<script>
(() => {
  /* ============================================================
   * Tempo Work Attribute Helper — v7.1
   * - Create + Edit (Grid/List)
   * - JSONP Task dropdown (ScriptRunner endpoint)
   * - AC warning (parent DM issues missing Activity Code) + hard submit block
   * - Injects Task using DC map-of-objects AND auto-discovers the canonical key
   *   by calling /rest/tempo-timesheets/4/work-attributes (e.g. "_Task_" vs "Task").
   * ============================================================ */

  /* ---------- Config ---------- */
  const ATTR_KEY         = "_Task_";             // used ONLY to find native row
  const NATIVE_LABEL     = "Task";
  const CUSTOM_LABEL     = "Task";
  const JSONP_ENDPOINT   = "/rest/scriptrunner/latest/custom/tempoWorkType";
  const AC_FIELD         = "customfield_17447";  // Activity Code
  const EXEMPT_ISSUES    = new Set(["DM-50267","DM-50238"]);
  const EXEMPT_TYPES     = new Set(["Sub-task","Sub-task (technical)","Change Request"]);
  const KTAXA_GROUP_NAME = "DM-KTAXA";
  const OBS_MS           = 120;

  /* ---------- State ---------- */
  const S = {
    ktaxa: null,
    lastIssueKey: null,
    lastSeenIssueKey: null,
    lastOptionsKey: null,
    selection: "",
    fetching: new Map(),
    acCache: new Map(),
    typeCache: new Map(),
    wiredXHR: false,
    wiredFetch: false,
    bodyMO: null,
    formMO: null,
    formMOStarted: false,
    debounceTimer: null,
    worklogKeyCache: new Map(),   // worklogId -> issueKey
    lastWorklogId: null,
    lastBlock: false,
    attrKey: null,                // ← canonical Tempo key for “Task”
    attrKeyLoaded: false
  };

  const log  = (...a) => console.log("%c[WorkAttr]", "color:#2aa", ...a);
  const warn = (...a) => console.warn("%c[WorkAttr]", "color:#d80", ...a);

  /* ---------- CSS ---------- */
  function onceStyle() {
    if (document.getElementById("workattr-style")) return;
    const css = `
      .workattr-hide-native{ display:none !important; }
      .custom-workattr-host{ margin:8px 0 8px; }
      .custom-workattr-label{ font-weight:600; display:block; margin-bottom:6px; }
      .custom-workattr-select{ width:100%; height:40px; }
      .custom-workattr-warning{ color:#c00; font-size:.85rem; margin-top:6px; }
      .workattr-disabled-btn{ pointer-events:none !important; opacity:.6 !important; }
    `;
    const el = document.createElement("style");
    el.id = "workattr-style";
    el.textContent = css;
    document.head.appendChild(el);
  }

  /* ---------- Basics ---------- */
  const RX_KEY = /\b[A-Z][A-Z0-9]+-\d+\b/;
  const isDM   = k => /^DM-\d+$/i.test(k || "");
  const getForm = () => document.querySelector("#worklogForm");
  const normalizeName = s => String(s||"").toLowerCase().replace(/[^a-z]/g,"");

  /* ---------- Canonical Tempo key discovery ---------- */
  async function loadTempoAttrKey(){
    if (S.attrKeyLoaded) return S.attrKey;
    S.attrKeyLoaded = true;
    try{
      const r = await fetch("/rest/tempo-timesheets/4/work-attributes");
      if (r.ok){
        const list = await r.json();
        const m = (Array.isArray(list) ? list : []).find(it =>
          normalizeName(it?.name) === "task" || normalizeName(it?.key) === "task"
        );
        if (m?.key){ S.attrKey = String(m.key); log("Tempo canonical key:", S.attrKey); return S.attrKey; }
      }
    }catch(e){}
    // Fallbacks — many DC installs use _Task_ as the actual key
    S.attrKey = "_Task_";
    log("Tempo canonical key fallback:", S.attrKey);
    return S.attrKey;
  }

  /* ---------- Attribute injection (DC map-of-objects) ---------- */
  function pickAttrKeyFromMap(attrs){
    if (attrs && typeof attrs === "object" && !Array.isArray(attrs)){
      const keys = Object.keys(attrs);
      const k1 = keys.find(k => normalizeName(k)==="task");
      if (k1) return k1;
      const k2 = keys.find(k => /^_?task_?$/i.test(k));
      if (k2) return k2;
    }
    return null;
  }

  // Ensure: "attributes": { "<Key>": { key:"<Key>", value:"<choice>" } }
  async function ensureTempoAttributes(obj, chosen){
    if (!obj) return;
    let attrs = obj.attributes;
    if (!attrs || typeof attrs !== "object" || Array.isArray(attrs)) attrs = {};

    // Prefer a key already present; else the canonical server key; else fallback
    let key = pickAttrKeyFromMap(attrs) || S.attrKey || await loadTempoAttrKey();

    // remove other Task-like keys so only one remains
    Object.keys(attrs).forEach(k => { if (normalizeName(k)==="task" && k!==key) delete attrs[k]; });

    attrs[key] = { key, value: chosen };
    obj.attributes = attrs;
    log("injecting", { [key]: attrs[key] });
  }

  /* ---------- KTAXA bypass ---------- */
  async function isKTAXA() {
    if (S.ktaxa !== null) return S.ktaxa;
    try {
      const r = await fetch("/rest/api/2/myself?expand=groups");
      if (!r.ok) throw 0;
      const me = await r.json();
      const names = (me?.groups?.items || []).map(g => (g?.name || "").toUpperCase());
      S.ktaxa = names.includes(KTAXA_GROUP_NAME.toUpperCase());
    } catch { S.ktaxa = false; }
    return S.ktaxa;
  }

  /* ---------- Issue key resolution ---------- */
  function extractIssueKeyFromDOM(form) {
    if (!form) return null;
    for (const a of form.querySelectorAll('a[href*="/browse/"]')) {
      const m = (a.getAttribute('href') || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const probes = [...form.querySelectorAll('[data-issue-key],[data-issueKey],[data-testid*="issue"],[data-test-id*="issue"],[role="button"],[title],[aria-label]')];
    for (const el of probes){
      const bag = [
        el.getAttribute('data-issue-key') || '',
        el.getAttribute('data-issueKey')  || '',
        el.getAttribute('data-testid')    || '',
        el.getAttribute('data-test-id')   || '',
        el.getAttribute('title')          || '',
        el.getAttribute('aria-label')     || '',
        el.textContent || ''
      ].join(' ');
      const m = bag.match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const desc = form.querySelector('#comment, textarea[id*="comment"]');
    if (desc) {
      const m = (desc.value || '').match(RX_KEY);
      if (m) return m[0].toUpperCase();
    }
    const m = (form.textContent || '').match(RX_KEY);
    return m ? m[0].toUpperCase() : null;
  }

  function getHidden(form, names){
    for (const n of names){
      const el = form?.querySelector?.(`input[name="${n}"], [id="${n}"]`);
      if (el && String(el.value||'').trim()) return String(el.value).trim();
    }
    return null;
  }

  async function fetchTempoWorklog(wlId){
    const urls = [
      `/rest/tempo-timesheets/4/worklogs/${encodeURIComponent(wlId)}/`,
      `/rest/tempo-timesheets/4/worklogs/${encodeURIComponent(wlId)}`
    ];
    for (const u of urls){ try{ const r=await fetch(u); if (r.ok) return await r.json(); }catch(e){} }
    return null;
  }

  function setResolved(key, source){
    if (!key) return null;
    key = key.toUpperCase();
    S.lastSeenIssueKey = key;
    log("issueKey resolved via", source, "→", key);
    if (getForm()) setTimeout(loadForCurrentForm, 0);
    return key;
  }

  async function resolveIssueKey(form){
    const domKey    = extractIssueKeyFromDOM(form); if (domKey) return setResolved(domKey,"DOM");
    const hiddenKey = getHidden(form,["issueKey","issue-key"]); if (hiddenKey) return setResolved(hiddenKey,"hidden:issueKey");

    const issueId = getHidden(form,["issueId","issue-id"]);
    if (issueId){
      try{
        const rx = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueId)}?fields=key`);
        if (rx.ok){ const jj=await rx.json(); const k=jj?.key || jj?.fields?.key; if (k) return setResolved(k,"Jira:issueId"); }
      }catch(e){}
    }

    const wlId = getHidden(form,["originId","worklogId","worklog-id"]) || S.lastWorklogId;
    if (!wlId) return null;
    if (S.worklogKeyCache.has(wlId)) return setResolved(S.worklogKeyCache.get(wlId),"cache:worklog");

    try{
      const j = await fetchTempoWorklog(wlId);
      if (j){
        let k   = j?.issue?.key || j?.issueKey || null;
        let iid = j?.issue?.id  || j?.issueId  || null;
        if (!k && iid){
          const rx = await fetch(`/rest/api/2/issue/${encodeURIComponent(iid)}?fields=key`);
          if (rx.ok){ const jj=await rx.json(); k = jj?.key || jj?.fields?.key || null; }
        }
        if (k){ S.worklogKeyCache.set(wlId,k); return setResolved(k,"Tempo:worklog"); }
      }
    }catch(e){}
    return null;
  }

  function sniffIssueKeyFromURL(url){
    if (!url) return;
    let key = null;
    const mQ = url.match(/[?&]issueKey=([^&#]+)/i);
    if (mQ) key = decodeURIComponent(mQ[1]);
    if (!key){
      const m1 = url.match(/\/issue\/([A-Z][A-Z0-9]+-\d+)/i);
      key = (m1 && m1[1]) || (url.match(RX_KEY)||[])[0] || null;
    }
    const mW = url.match(/\/rest\/tempo-timesheets\/\d+\/worklogs\/(\d+)\/?$/i);
    if (mW){ S.lastWorklogId = mW[1]; }
    if (key) setResolved(key,"URL");
  }

  /* ---------- DOM Task row helpers ---------- */
  function findNativeTaskRow(form) {
    if (!form) return null;
    let lab = form.querySelector(`label[for="${ATTR_KEY}"]`);
    if (!lab) lab = [...form.querySelectorAll("label")]
      .find(l => (l.textContent || "").trim().toLowerCase() === NATIVE_LABEL.toLowerCase());
    if (!lab) return null;
    return lab.closest('[role="group"], .aui-field, .sc-bKhNmF') || lab.parentElement?.parentElement || lab.parentElement;
  }

  function hideNativeTaskRows(form){
    const host = form.querySelector('#custom-workattr-host');
    if (!host) return;

    const ROW_SEL = '[role="group"], .aui-field, .sc-bKhNmF';
    const hostRow = host.closest(ROW_SEL) || host;
    const rows = new Set();

    form.querySelectorAll('label').forEach(lab => {
      const txt = (lab.textContent || '').trim().toLowerCase();
      if (txt !== NATIVE_LABEL.toLowerCase()) return;
      if (lab.closest('#custom-workattr-host')) return;
      const r = lab.closest(ROW_SEL) || lab.parentElement;
      if (r && r !== hostRow) rows.add(r);
    });

    const ctrlSel = [
      `[id="${ATTR_KEY}"]`,
      `[name="${ATTR_KEY}"]`,
      `[aria-label="${NATIVE_LABEL}"]`,
      '[data-test-id*="work-attribute"] select',
      '[data-test-id*="work-attribute"] [role="combobox"]'
    ].join(',');

    form.querySelectorAll(ctrlSel).forEach(ctrl => {
      if (ctrl.closest('#custom-workattr-host')) return;
      const r = ctrl.closest(ROW_SEL) || ctrl.parentElement;
      if (r && r !== hostRow) rows.add(r);
    });

    rows.forEach(r => r.classList.add('workattr-hide-native'));
  }

  function ensureCustomHost(form) {
    if (!form) return null;
    let host = form.querySelector("#custom-workattr-host");
    if (host) return host;

    const nativeRow = findNativeTaskRow(form);
    const insertAfter = nativeRow || form.querySelector('[role="group"], .aui-field, .sc-bKhNmF');
    if (!insertAfter) return null;

    host = document.createElement("div");
    host.id = "custom-workattr-host";
    host.className = "custom-workattr-host";
    host.innerHTML = `
      <label class="custom-workattr-label" for="custom-workattr-select">${CUSTOM_LABEL}</label>
      <select id="custom-workattr-select" class="custom-workattr-select">
        <option value="">Select an option...</option>
      </select>
      <div id="custom-workattr-warning" class="custom-workattr-warning" style="display:none;">
        Log Time is disabled since Activity Code is not yet available. Please select your Domain BAU demand to log it temporarily to BAU.
      </div>
    `;

    if (insertAfter?.parentElement) {
      insertAfter.parentElement.insertBefore(host, insertAfter.nextSibling);
    } else {
      form.appendChild(host);
    }

    hideNativeTaskRows(form);
    setTimeout(() => hideNativeTaskRows(form), 0);
    setTimeout(() => hideNativeTaskRows(form), 250);

    return host;
  }

  const getCustomSelect = (form) => form?.querySelector("#custom-workattr-select") || null;
  const getWarnBox     = (form) => form?.querySelector("#custom-workattr-warning") || null;

  function getSubmitBtn(form) {
    const sels = [
      'button[name="submitWorklogButton"]',
      'button[type="submit"]',
      'button[id*="submit"][id*="worklog"]',
      'button[data-test-id*="submit"]',
      'button[data-testid*="submit"]',
      'button[data-test-id*="log"]',
      'button[data-testid*="log"]'
    ];
    for (const s of sels){ const b=form.querySelector(s); if (b) return b; }
    const byText = [...(form.querySelectorAll('button, [role="button"]')||[])]
      .find(b=>/log time|update/i.test((b.textContent||'').trim()));
    if (byText) return byText;
    return [...(form.querySelectorAll('button')||[])].reverse()
      .find(b=>/primary|aui-button-primary/i.test(b.className)) || null;
  }

  /* ---------- JSONP options ---------- */
  function jsonp(url) {
    return new Promise((resolve, reject) => {
      const cb = "tempoWorkAttrCB_" + Math.random().toString(36).slice(2);
      const sep = url.includes("?") ? "&" : "?";
      const s = document.createElement("script");
      window[cb] = (d) => { try{delete window[cb]}catch{} s.remove(); resolve(d); };
      s.onerror  = () => { try{delete window[cb]}catch{} s.remove(); reject(new Error("JSONP failed")); };
      s.src = `${url}${sep}callback=${cb}`;
      document.body.appendChild(s);
    });
  }

  async function fetchOptionsFor(issueKey) {
    if (!issueKey) return [];
    if (S.fetching.has(issueKey)) return S.fetching.get(issueKey);
    const p = (async () => {
      const data = await jsonp(`${JSONP_ENDPOINT}?issueKey=${encodeURIComponent(issueKey)}`).catch(() => ({}));
      const list = Array.isArray(data?.values) ? data.values : [];
      return list.map(v => ({ key: v.key, value: v.value }));
    })();
    S.fetching.set(issueKey, p);
    return p;
  }

  function fillSelect(select, options, preselect) {
    const keep = new Set();
    select.innerHTML = `<option value="">Select an option...</option>`;
    for (const opt of options) {
      if (!opt || !opt.value || keep.has(opt.value)) continue;
      keep.add(opt.value);
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.value;
      select.appendChild(o);
    }
    if (preselect && keep.has(preselect)) select.value = preselect;
  }

  /* ---------- Gate (warning + disable + hard block) ---------- */
  function enforceDisabled(form, block){
    const btn = getSubmitBtn(form);
    if (!btn) return;
    btn.disabled = !!block;
    btn.setAttribute("aria-disabled", String(!!block));
    btn.classList.toggle("workattr-disabled-btn", !!block);
    setTimeout(()=>{ btn.disabled=!!block; btn.setAttribute("aria-disabled", String(!!block));
      btn.classList.toggle("workattr-disabled-btn", !!block); }, 80);

    if (!btn.__workattrGuarded){
      btn.__workattrGuarded = true;
      btn.addEventListener("click", (ev) => { if (S.lastBlock){ ev.stopImmediatePropagation(); ev.preventDefault(); } }, true);
    }
    if (!form.__workattrSubmitGuard){
      form.__workattrSubmitGuard = true;
      form.addEventListener("submit", (ev) => { if (S.lastBlock){ ev.stopImmediatePropagation(); ev.preventDefault(); } }, true);
    }
  }

  async function getIssueMeta(issueKey) {
    if (!issueKey) return { isParent:true, hasAC:true };
    if (S.typeCache.has(issueKey) && S.acCache.has(issueKey)) {
      return { isParent: S.typeCache.get(issueKey), hasAC: S.acCache.get(issueKey) };
    }
    try {
      const r = await fetch(`/rest/api/2/issue/${encodeURIComponent(issueKey)}?fields=${AC_FIELD},issuetype,parent`);
      if (!r.ok) throw 0;
      const j = await r.json();
      const typeName = (j?.fields?.issuetype?.name || "").trim();
      const hasParent = !!j?.fields?.parent;
      const isParent = !(hasParent || EXEMPT_TYPES.has(typeName));
      const acVal = j?.fields?.[AC_FIELD];
      const hasAC = !!(acVal && String(acVal).trim().length > 0);
      S.typeCache.set(issueKey, isParent);
      S.acCache.set(issueKey, hasAC);
      return { isParent, hasAC };
    } catch {
      S.typeCache.set(issueKey, true);
      S.acCache.set(issueKey, true);
      return { isParent:true, hasAC:true };
    }
  }

  async function applyGate(form) {
    if (!form) return;

    if (await isKTAXA()) {
      const row = findNativeTaskRow(form);
      if (row) row.classList.remove("workattr-hide-native");
      form.querySelector("#custom-workattr-host")?.remove();
      const warnBox = getWarnBox(form);
      if (warnBox) warnBox.style.display = "none";
      S.lastBlock = false;
      enforceDisabled(form, false);
      return;
    }

    const key = S.lastIssueKey;
    const select = getCustomSelect(form);
    const warnBox = getWarnBox(form);
    const hasTask = !!(select && select.value);

    let showWarn = false;
    if (key && isDM(key) && !EXEMPT_ISSUES.has(key)) {
      const { isParent, hasAC } = await getIssueMeta(key);
      showWarn = isParent && !hasAC;
    }
    if (warnBox) warnBox.style.display = showWarn ? "block" : "none";

    S.lastBlock = (showWarn || !hasTask);
    enforceDisabled(form, S.lastBlock);
  }

  /* ---------- Loader ---------- */
  async function loadForCurrentForm() {
    const form = getForm();
    if (!form) return;
    if (S.debounceTimer) clearTimeout(S.debounceTimer);

    S.debounceTimer = setTimeout(async () => {
      await loadTempoAttrKey();  // ← learn the canonical key asap

      const issueKey = (await resolveIssueKey(form)) || S.lastSeenIssueKey;
      if (!issueKey) { warn("issueKey not found"); return; }

      if (S.lastIssueKey !== issueKey) {
        S.lastIssueKey = issueKey;
        S.selection = "";
      }

      if (await isKTAXA()) {
        const row = findNativeTaskRow(form);
        if (row) row.classList.remove("workattr-hide-native");
        form.querySelector("#custom-workattr-host")?.remove();
        const warnBox = getWarnBox(form);
        if (warnBox) warnBox.style.display = "none";
        S.lastBlock = false;
        enforceDisabled(form, false);
        return;
      }

      onceStyle();
      const host = ensureCustomHost(form);
      if (!host) return;

      const select = getCustomSelect(form);
      if (S.lastOptionsKey !== issueKey) {
        const options = await fetchOptionsFor(issueKey).catch(() => []);
        S.lastOptionsKey = issueKey;
        fillSelect(select, options, S.selection);
        log("options", options.length, "loaded for", issueKey);
      }

      if (!select.__workattrBound) {
        select.__workattrBound = true;
        select.addEventListener("change", () => { S.selection = select.value || ""; applyGate(form); });
      }

      if (!form.__gateBound){
        form.__gateBound = true;
        form.addEventListener("change", () => applyGate(form));
        form.addEventListener("input",  () => applyGate(form));
      }

      await applyGate(form);
    }, OBS_MS);
  }

  /* ---------- Network wiring ---------- */
  function looksLikeCreateUpdate(o){
    if (!o || typeof o!=="object") return false;
    if ("started" in o) return true;
    if ("timeSpentSeconds" in o) return true;
    if ("originTaskId" in o) return true;
    if ("issueId" in o) return true;
    if ("from" in o || "to" in o) return false;
    if ("offset" in o || "limit" in o) return false;
    return false;
  }

  function wireNetwork(){
    // XHR
    if (!S.wiredXHR){
      S.wiredXHR = true;
      const _open = XMLHttpRequest.prototype.open;
      const _send = XMLHttpRequest.prototype.send;

      XMLHttpRequest.prototype.open = function(method, url, ...rest) {
        try { sniffIssueKeyFromURL(url); } catch {}
        this.__url = url || "";
        this.__method = (method || "").toUpperCase();
        return _open.call(this, method, url, ...rest);
      };

      XMLHttpRequest.prototype.send = function(body) {
        try{
          if (S.ktaxa === true) return _send.call(this, body);

          const isMut = /POST|PUT/.test(this.__method || "");
          if (!isMut || !body || typeof body !== "string") {
            return _send.call(this, body);
          }
          let obj; try { obj = JSON.parse(body); } catch { obj = null; }
          if (looksLikeCreateUpdate(obj)) {
            const form = getForm();
            const sel  = form && getCustomSelect(form);
            const chosen = (sel && sel.value) || S.selection || "";
            if (chosen) {
              if ("endDate" in obj && obj.endDate == null) delete obj.endDate; // defensive
              ensureTempoAttributes(obj, chosen);
              body = JSON.stringify(obj);
              log("✅ Injected into XHR");
            }
          }
        }catch(e){ warn("XHR inject skipped due to error:", e); }
        return _send.call(this, body);
      };
    }

    // fetch
    if (!S.wiredFetch && window.fetch){
      S.wiredFetch = true;
      const _fetch = window.fetch;
      window.fetch = async (input, init = {}) => {
        try{
          const url  = typeof input === "string" ? input : (input?.url || "");
          const meth = (init?.method || "GET").toUpperCase();
          sniffIssueKeyFromURL(url);

          if (S.ktaxa === true) return _fetch(input, init);

          if (/POST|PUT/.test(meth) && init?.body && typeof init.body === "string"){
            let obj; try { obj = JSON.parse(init.body); } catch { obj = null; }
            if (looksLikeCreateUpdate(obj)) {
              const form = getForm();
              const sel  = form && getCustomSelect(form);
              const chosen = (sel && sel.value) || S.selection || "";
              if (chosen) {
                if ("endDate" in obj && obj.endDate == null) delete obj.endDate; // defensive
                ensureTempoAttributes(obj, chosen);
                init = { ...init, body: JSON.stringify(obj) };
                log("✅ Injected into fetch");
              }
            }
          }
        }catch(e){ warn("fetch inject skipped due to error:", e); }
        return _fetch(input, init);
      };
    }
  }

  /* ---------- Observers & boot ---------- */
  function wireObservers() {
    if (!S.bodyMO) {
      S.bodyMO = new MutationObserver(() => {
        const form = getForm();
        if (form && !S.formMOStarted) {
          if (!S.formMO) S.formMO = new MutationObserver(() => loadForCurrentForm());
          S.formMO.observe(form, { childList: true, subtree: true, characterData: true });
          S.formMOStarted = true;
          loadForCurrentForm();
        } else if (!form && S.formMOStarted) {
          S.formMO.disconnect();
          S.formMOStarted = false;
        }
      });
      S.bodyMO.observe(document.body, { childList: true, subtree: true });
    }
    loadForCurrentForm();
  }

  function boot() {
    onceStyle();
    wireNetwork();
    wireObservers();
    loadTempoAttrKey();  // fire in the background so we know the key early
    log("Ready (v7.1)");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
